<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VarthexComanda.Application\VarthexComanda.Application.csproj" />
    <ProjectReference Include="..\VarthexComanda.Infrastructure\VarthexComanda.Infrastructure.csproj" />
    <ProjectReference Include="..\VarthexComanda.Servidor\VarthexComanda.Servidor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\VarthexComanda.ico" />
    <Resource Include="Assets\LogoBranca.png" />
    <Resource Include="Assets\AberturaFundo.png" />
    <Resource Include="Assets\LogoRodape.png" />
    <Resource Include="Assets\LogoAjudaClara.png" />
    <Resource Include="Assets\LogoAjudaEscura.png" />
    <Resource Include="Assets\MascoteComanda.png" />
    <EmbeddedResource Include="Licenciamento\licenca-publica.pem" LogicalName="VarthexComanda.licenca-publica.pem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VarthexComanda</AssemblyName>
    <RootNamespace>VarthexComanda.Desktop</RootNamespace>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <InformationalVersion>1.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Comanda</AssemblyTitle>
    <Product>Comanda</Product>
    <Company>Varthex</Company>
