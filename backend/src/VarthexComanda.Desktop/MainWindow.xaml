<Window x:Class="VarthexComanda.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VarthexComanda.Desktop"
        mc:Ignorable="d"
        Title="Comanda" Icon="pack://application:,,,/VarthexComanda;component/Assets/VarthexComanda.ico" Height="780" Width="1280" MinHeight="600" MinWidth="800">
    <Window.Resources>
        <local:TextoMaiusculoConverter x:Key="TextoMaiusculo"/>
        <DataTemplate x:Key="RotuloCategoriaRibbon"><TextBlock Text="{Binding Converter={StaticResource TextoMaiusculo}}"/></DataTemplate>
        <Style x:Key="AcaoSessao" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BackgroundFFFFFF}" />
            <Setter Property="Foreground" Value="{DynamicResource Text263C32}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color87988E}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="AbaNavegacao" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BackgroundFFFFFF}" />
            <Setter Property="Foreground" Value="{DynamicResource Text263C32}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="RotuloAba" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ativa"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource RibbonSurface}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource RibbonHover}" />
                            <Setter TargetName="RotuloAba" Property="TextElement.Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaAtendimentoCommand}" />
        <KeyBinding Key="NumPad1" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaAtendimentoCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaHistoricoCommand}" />
        <KeyBinding Key="NumPad2" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaHistoricoCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaProdutosCommand}" />
        <KeyBinding Key="NumPad3" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaProdutosCommand}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaConfiguracoesCommand}" />
        <KeyBinding Key="NumPad4" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaConfiguracoesCommand}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaBackupCommand}" />
        <KeyBinding Key="NumPad5" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaBackupCommand}" />
    </Window.InputBindings>
    <Grid>
    <DockPanel x:Name="AreaSistema" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <DockPanel.Style>
            <Style TargetType="DockPanel"><Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Effect"><Setter.Value><BlurEffect Radius="5" RenderingBias="Performance"/></Setter.Value></Setter></Trigger>
            </Style.Triggers></Style>
        </DockPanel.Style>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource RibbonBar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="8,2">
            <Border.Resources><SolidColorBrush x:Key="HoverOverlay" Color="#26FFFFFF"/></Border.Resources>
            <DockPanel LastChildFill="False">
                <Image DockPanel.Dock="Right" Source="{DynamicResource MarcaLogoRodape}" Width="112" Height="28" Stretch="Uniform" Margin="12,0,0,0" AutomationProperties.Name="Comanda, por Varthex"/>
                <Button x:Name="BotaoBackupRodape" DockPanel.Dock="Right" Content="Backup e restauração" Click="BackupRodape_Click" Background="Transparent" Foreground="White" BorderThickness="0" MinHeight="28" Padding="8,3" FontSize="11" ToolTip="Consultar cópias e restaurar dados. Requer acesso de gestor." />
                <TextBlock x:Name="UsuarioRodape" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Border BorderBrush="#666666" BorderThickness="1,0,0,0" Padding="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LicencaRodape" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </Border>
            </DockPanel>
        </Border>
        <!-- Visivel apenas no modo de restauracao (banco corrompido): ver MainWindow.EntrarModoRestauracao. -->
        <Border x:Name="FaixaRestauracao" DockPanel.Dock="Top" Background="{DynamicResource BackgroundB71C1C}" Padding="16,12" Visibility="Collapsed">
            <TextBlock Text="O banco de dados está corrompido. Restaure um backup para continuar. Nenhuma outra função está disponível."
                       Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>
        <Border DockPanel.Dock="Top" Background="{DynamicResource RibbonSurface}" TextElement.Foreground="{DynamicResource RibbonInk}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
<StackPanel>
<Grid Background="{DynamicResource RibbonBar}">
<Grid.Resources><SolidColorBrush x:Key="HoverOverlay" Color="#26FFFFFF"/></Grid.Resources>
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<WrapPanel VerticalAlignment="Center">
<WrapPanel x:Name="CategoriasRibbon"/>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<Button x:Name="BotaoPesquisar" Click="AbrirPesquisa_Click" Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,7" MinHeight="36" FontSize="12" ToolTip="Pesquisar · Ctrl+K" AutomationProperties.Name="Pesquisar">
<StackPanel Orientation="Horizontal"><Path Data="M14,8 A6,6 0 1 1 2,8 A6,6 0 1 1 14,8 M13,13 L19,19" Stroke="White" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Pesquisar" VerticalAlignment="Center"/></StackPanel>
</Button>
<TextBox x:Name="PesquisaGlobal" Visibility="Collapsed" Width="180" MinHeight="30" FontSize="12" Padding="6,3" Background="{DynamicResource RibbonBar}" Foreground="White" CaretBrush="White" BorderThickness="0" TextChanged="PesquisaGlobal_TextChanged" PreviewKeyDown="PesquisaGlobal_KeyDown" LostKeyboardFocus="PesquisaGlobal_LostKeyboardFocus" AutomationProperties.Name="Pesquisar funcionalidades e produtos" ToolTip="Pesquisar · Ctrl+K"/>
</StackPanel>
</WrapPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Top">
<CheckBox x:Name="ModoEscuro" Style="{StaticResource AlternanciaCompacta}" Content="Modo escuro" Foreground="White" Margin="0,0,12,0" VerticalAlignment="Center" Checked="ModoEscuro_Changed" Unchecked="ModoEscuro_Changed" ToolTip="Ativar ou desativar o modo escuro. A preferência é salva neste computador." AutomationProperties.Name="Modo escuro"/>
<Button Content="Bloquear ou trocar usuário" Click="MenuSessao_Click" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="12" MinHeight="34" Padding="8,4"/>
</StackPanel>
</Grid>
<StackPanel Visibility="Collapsed"><TextBlock x:Name="RotuloPerfil"/><Button x:Name="BotaoPerfil" Click="AlternarPerfil_Click"/></StackPanel>
<ListBox x:Name="ResultadosPesquisa" Visibility="Collapsed" MaxHeight="160" Margin="12,0" DisplayMemberPath="Nome" PreviewKeyDown="ResultadosPesquisa_KeyDown" MouseDoubleClick="ResultadosPesquisa_MouseDoubleClick"/>
<Grid Margin="4,4,4,4"><WrapPanel x:Name="GruposRibbon"/><Button x:Name="RibbonCompacta" Content="Comandos da categoria ▾" HorizontalAlignment="Left" Visibility="Collapsed" Click="RibbonCompacta_Click"/></Grid>
<WrapPanel x:Name="AbasNavegacao" Visibility="Collapsed">
<Button x:Name="BotaoAtendimento" Click="MostrarAtendimento_Click" Content="Mesas / comandas"/>
<Button x:Name="BotaoHistorico" Click="MostrarHistorico_Click" Content="Histórico de vendas"/>
<Button x:Name="BotaoProdutos" Click="MostrarProdutos_Click" Content="Produtos"/>
<Button x:Name="BotaoBackup" Click="MostrarBackup_Click" Content="Backup"/>
<Button x:Name="BotaoConfiguracoes" Click="MostrarConfiguracao_Click" Content="Configurações"/>
<Button x:Name="BotaoLicenca" Click="MostrarLicenca_Click" Content="Licença"/>
<Button x:Name="BotaoCozinha" Click="MostrarCozinha_Click" Content="Comandas abertas"/>
</WrapPanel></StackPanel></Border>
        <Grid Background="{DynamicResource Canvas}"><Border x:Name="FundoTrabalho"/><Border x:Name="ImagemTrabalho"/><local:AreaTrabalhoInterna x:Name="ConteudoPrincipal" />
            <Grid x:Name="BalaoAjudaMascote" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="12,12,16,124" Width="220" Panel.ZIndex="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/></Grid.RowDefinitions>
                <Border CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Click="AbrirAjudaMascote_Click" Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand"
                            Foreground="{DynamicResource Ink}" AutomationProperties.Name="Precisa de ajuda? Abrir opções de ajuda">
                        <TextBlock Text="Precisa de ajuda?&#10;Clique aqui." TextWrapping="Wrap" FontSize="14"/>
                    </Button>
                    <Button Grid.Column="1" Click="FecharDicaMascote_Click" Content="×" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource Ink}" Width="28" Height="28" Padding="0" VerticalAlignment="Top"
                            ToolTip="Fechar dica" AutomationProperties.Name="Fechar dica do mascote"/>
                </Grid>
                </Border>
                <Path Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,44,0"
                      Data="M0,0 L12,10 L24,0 Z" Fill="{DynamicResource Surface}" IsHitTestVisible="False"/>
                <Path Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,44,0"
                      Data="M0,0 L12,10 L24,0" Stroke="{DynamicResource Line}" StrokeThickness="1" IsHitTestVisible="False"/>
            </Grid>
            <Button x:Name="BotaoAjudaFlutuante" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="112" Height="112" Margin="16" Panel.ZIndex="3"
                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                    ToolTip="Opções de ajuda" AutomationProperties.Name="Abrir opções de ajuda" Click="AjudaFlutuante_Click">
                <Button.FocusVisualStyle>
                    <Style TargetType="Control">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Control">
                                    <Border BorderBrush="{DynamicResource Ink}" BorderThickness="2" CornerRadius="14" Margin="2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.FocusVisualStyle>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocoMascote" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="14">
                            <ContentPresenter x:Name="ConteudoMascote" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ConteudoMascote" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ConteudoMascote" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ConteudoMascote" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </DockPanel>
    <ContentControl x:Name="CamadaBloqueio" Panel.ZIndex="10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
