<UserControl x:Class="VarthexComanda.Desktop.BloqueioAtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
    <UserControl.Resources>
        <Style x:Key="TeclaPin" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="62" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#D923262B">
        <Viewbox Margin="20" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="420" Background="#F2F2F0" Padding="24" BorderBrush="#C4C4C4" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <TextBlock x:Name="Titulo" Text="Atendimento bloqueado" FontSize="25" FontWeight="Bold" Foreground="#23252A" TextAlignment="Center" />
                    <TextBlock x:Name="Instrucao" Text="Digite o PIN para iniciar um atendimento." FontSize="15" Foreground="#555555" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,16" />
                    <Border Background="White" BorderBrush="#999999" BorderThickness="1" Padding="8" Height="54">
                        <TextBlock x:Name="Visor" Text="PIN" AutomationProperties.Name="PIN oculto" FontSize="27" TextAlignment="Center" VerticalAlignment="Center" Foreground="#555555" />
                    </Border>
                    <TextBlock x:Name="Mensagem" TextWrapping="Wrap" Foreground="#A12822" MinHeight="38" FontSize="14" Margin="4,8,4,4" AutomationProperties.LiveSetting="Polite" />
                    <UniformGrid Columns="3">
                        <Button Content="1" Style="{StaticResource TeclaPin}" Click="Digito_Click" />
                        <Button Content="2" Style="{StaticResource TeclaPin}" Click="Digito_Click" />
                        <Button Content="3" Style="{StaticResource TeclaPin}" Click="Digito_Click" />
                        <Button Content="4" Style="{StaticResource TeclaPin}" Click="Digito_Click" />
                        <Button Content="5" Style="{StaticResource TeclaPin}" Click="Digito_Click" />
                        <Button Content="6" Style="{StaticResource TeclaPin}" Click="Digito_Click" />
                        <Button Content="7" Style="{StaticResource TeclaPin}" Click="Digito_Click" />
                        <Button Content="8" Style="{StaticResource TeclaPin}" Click="Digito_Click" />
                        <Button Content="9" Style="{StaticResource TeclaPin}" Click="Digito_Click" />
                        <Button Content="Limpar" FontSize="15" Style="{StaticResource TeclaPin}" Click="Limpar_Click" />
                        <Button Content="0" Style="{StaticResource TeclaPin}" Click="Digito_Click" />
                        <Button Content="Apagar" FontSize="15" Style="{StaticResource TeclaPin}" Click="Apagar_Click" />
                    </UniformGrid>
                    <Button x:Name="BotaoEntrar" Content="Desbloquear" Click="Entrar_Click" Height="54" Margin="4,12,4,0" Background="#326F4C" Foreground="White" FontWeight="Bold" FontSize="18" />
                    <Button x:Name="BotaoConfigurar" Content="Configurar PIN · somente gestor" Click="Configurar_Click" Margin="4,8,4,0" Background="Transparent" BorderThickness="0" FontSize="14" />
                    <Button Content="Voltar ao início" Click="Voltar_Click" Margin="4,2,4,0" Background="Transparent" BorderThickness="0" FontSize="14" />
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
