<UserControl x:Class="VarthexComanda.Desktop.Registros.RegistrosView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:backup="clr-namespace:VarthexComanda.Desktop.Backup"
 FontFamily="Segoe UI" FontSize="12" Language="pt-BR" Background="{DynamicResource AjudaCanvas}" Foreground="{DynamicResource AjudaInk}">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Atendimento/EstilosHistorico.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visivel"/><backup:UtcParaDataHoraLocalConverter x:Key="DataLocal"/>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="RowHeight" Value="36"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AjudaLine}"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#176BD1"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Fundo" Padding="16,10" Background="{DynamicResource AjudaCanvas}" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource AjudaHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TextoEstado" TargetType="TextBlock" BasedOn="{StaticResource TextoTabela}"><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><DataTrigger Binding="{Binding Situacao}" Value="Concluído"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger><DataTrigger Binding="{Binding Situacao}" Value="Falha"><Setter Property="Foreground" Value="{DynamicResource PrioridadeNumeroAlta}"/></DataTrigger><DataTrigger Binding="{Binding Situacao}" Value="Recusado"><Setter Property="Foreground" Value="{DynamicResource PrioridadeNumeroMediana}"/></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Logs e fila de eventos" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Diagnóstico das operações do Comanda neste computador." Foreground="{DynamicResource AjudaMuted}" Margin="0,5,12,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Atualizar" Command="{Binding AtualizarCommand}" Padding="16,8" VerticalAlignment="Top" MinHeight="36"/></Grid>
  <StackPanel Grid.Row="1" Margin="0,0,0,10"><Label Content="Pesquisar nos registros" Target="{Binding ElementName=Busca}" Padding="0,0,0,4"/><TextBox x:Name="Busca" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" AutomationProperties.Name="Pesquisar nos registros"/><TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Foreground="{DynamicResource PrioridadeNumeroAlta}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  <TabControl Grid.Row="2" Background="{DynamicResource AjudaSurface}" Foreground="{DynamicResource AjudaInk}" BorderBrush="{DynamicResource AjudaLine}" Padding="10">
   <TabItem Header="_Logs"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="110"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,10"><ComboBox ItemsSource="{Binding Niveis}" SelectedItem="{Binding Nivel}" Width="160" MinHeight="34" AutomationProperties.Name="Nível dos logs" Margin="0,0,12,0"/><TextBlock Text="Últimos 500 registros em disco. Selecione uma linha para ler os detalhes." VerticalAlignment="Center" Foreground="{DynamicResource AjudaMuted}" TextWrapping="Wrap" MaxWidth="400"/></WrapPanel>
    <Grid Grid.Row="1"><DataGrid x:Name="TabelaLogs" ItemsSource="{Binding Logs}" SelectedItem="{Binding LogSelecionado}" AutomationProperties.Name="Registros de logs"><DataGrid.Columns><DataGridTextColumn Header="Data / hora" Binding="{Binding Data}" Width="175" ElementStyle="{StaticResource TextoTabela}"/><DataGridTextColumn Header="Nível" Binding="{Binding Nivel}" Width="65" ElementStyle="{StaticResource TextoTabela}"/><DataGridTextColumn Header="Mensagem" Binding="{Binding Mensagem}" Width="*" MinWidth="180" ElementStyle="{StaticResource TextoTabela}"/></DataGrid.Columns></DataGrid><TextBlock Text="Nenhum registro encontrado. Altere a busca ou atualize a lista." TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,45,18,0" Foreground="{DynamicResource AjudaMuted}" Visibility="{Binding LogsVazios, Converter={StaticResource Visivel}}" IsHitTestVisible="False"/></Grid>
    <TextBox Grid.Row="2" Text="{Binding LogSelecionado.Mensagem, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" AutomationProperties.Name="Detalhes do registro selecionado"/>
   </Grid></TabItem>
   <TabItem Header="_Fila de eventos"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,10"><ComboBox ItemsSource="{Binding Origens}" SelectedItem="{Binding Origem}" Width="165" MinHeight="34" Margin="0,0,10,6" AutomationProperties.Name="Origem do evento"/><ComboBox ItemsSource="{Binding Estados}" SelectedItem="{Binding Estado}" Width="165" MinHeight="34" Margin="0,0,10,6" AutomationProperties.Name="Estado do evento"/></WrapPanel>
    <TextBlock Grid.Row="1" Text="{Binding Resumo}" Margin="0,0,0,10" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <Grid Grid.Row="2"><DataGrid x:Name="TabelaEventos" ItemsSource="{Binding Eventos}" AutomationProperties.Name="Fila de eventos"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" ElementStyle="{StaticResource TextoTabela}"/><DataGridTextColumn Header="Recebido em" Binding="{Binding CriadoEm, Converter={StaticResource DataLocal}}" Width="145" ElementStyle="{StaticResource TextoTabela}"/><DataGridTextColumn Header="Origem" Binding="{Binding Origem}" Width="110" ElementStyle="{StaticResource TextoTabela}"/><DataGridTextColumn Header="Operação" Binding="{Binding Operacao}" Width="*" MinWidth="140" ElementStyle="{StaticResource TextoTabela}"/><DataGridTextColumn Header="Estado" Binding="{Binding Situacao}" Width="115" ElementStyle="{StaticResource TextoEstado}"/></DataGrid.Columns></DataGrid><TextBlock Text="Nenhum evento encontrado. As operações aparecerão aqui conforme forem realizadas." TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,45,18,0" Foreground="{DynamicResource AjudaMuted}" Visibility="{Binding EventosVazios, Converter={StaticResource Visivel}}" IsHitTestVisible="False"/></Grid>
    <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding AvisoLimite}" TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}"/><TextBlock Text="Abertura de comandas, inclusão de itens, preparo no KDS e pedidos recebidos pelo servidor. A fila acompanha as operações; não reenvia pedidos." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}" Margin="0,5,0,0"/></StackPanel>
   </Grid></TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" Text="{Binding Contagem}" Margin="0,10,0,0" Foreground="{DynamicResource AjudaMuted}"/>
 </Grid>
</UserControl>
