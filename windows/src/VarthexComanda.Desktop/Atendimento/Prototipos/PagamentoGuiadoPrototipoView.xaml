<UserControl x:Class="VarthexComanda.Desktop.Atendimento.Prototipos.PagamentoGuiadoPrototipoView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:a="clr-namespace:VarthexComanda.Desktop.Atendimento" xmlns:d="clr-namespace:VarthexComanda.Domain;assembly=VarthexComanda.Domain"
 Background="{DynamicResource AjudaCanvas}" Foreground="{DynamicResource AjudaInk}" FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visivel"/><a:CentavosParaMoedaConverter x:Key="Moeda"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,7"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="10,6"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/></Style>
 </UserControl.Resources>
 <Grid Margin="22,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><TextBlock DockPanel.Dock="Right" Text="{Binding Fluxo.Pagamento.NumeroComanda,StringFormat='Comanda {0}'}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="Pagamento" FontSize="24" FontWeight="SemiBold"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="0,0,1,0" Padding="0,0,18,0">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="Resumo da conta" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <TextBlock Text="Total" Foreground="{DynamicResource AjudaMuted}"/><TextBlock Text="{Binding Fluxo.Pagamento.TotalCentavos,Converter={StaticResource Moeda}}" FontSize="20" Margin="0,3,0,14"/>
      <TextBlock Text="Já recebido" Foreground="{DynamicResource AjudaMuted}"/><TextBlock Text="{Binding Fluxo.Pagamento.TotalPagoCentavos,Converter={StaticResource Moeda}}" FontSize="20" Margin="0,3,0,14"/>
      <TextBlock Text="Falta receber"/><TextBlock Text="{Binding Fluxo.Pagamento.FaltaPagarCentavos,Converter={StaticResource Moeda}}" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,18"/>
      <TextBlock Text="{Binding Fluxo.Pagamento.Pagamentos.Count,StringFormat='Recebimentos ({0})'}" FontWeight="SemiBold" Margin="0,0,0,10"/>
     </StackPanel>
     <Border DockPanel.Dock="Bottom" Visibility="{Binding Fluxo.TemRemocao,Converter={StaticResource Visivel}}" Background="{DynamicResource AjudaSoft}" Padding="8" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding Fluxo.ResumoRemocao}" TextWrapping="Wrap"/><TextBlock Text="Remove apenas o registro. Não devolve dinheiro." FontSize="11" TextWrapping="Wrap" Margin="0,6,0,8"/><Button Content="Manter registro" Command="{Binding Fluxo.ManterRegistroCommand}" Margin="0,0,0,5"/><Button Content="Remover registro" Command="{Binding Fluxo.ConfirmarRemocaoCommand}"/></StackPanel></Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="Nenhum recebimento registrado." Visibility="{Binding Fluxo.SemRecebimentos,Converter={StaticResource Visivel}}" Foreground="{DynamicResource AjudaMuted}" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Fluxo.Pagamento.Pagamentos}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ValorCentavos,Converter={StaticResource Moeda}}" FontWeight="SemiBold"/><TextBlock Text="{Binding FormaDescricao}"/></DockPanel><Button Content="Corrigir" Command="{Binding DataContext.Fluxo.PedirRemocaoCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MinHeight="28" Padding="7,3" HorizontalAlignment="Left" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer>
    </DockPanel>
   </Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="Forma   ›   Valor   ›   Conferência" Foreground="{DynamicResource AjudaMuted}" FontSize="12"/><TextBlock Text="{Binding EtapaDescricao}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
     <StackPanel Visibility="{Binding EscolhendoForma,Converter={StaticResource Visivel}}"><TextBlock Text="Como o cliente vai pagar?" Foreground="{DynamicResource AjudaMuted}" Margin="0,0,0,16"/>
      <UniformGrid Columns="2" Margin="0,0,-10,0">
       <Button Content="Dinheiro" FontSize="18" MinHeight="78" Command="{Binding SelecionarFormaCommand}" CommandParameter="{x:Static d:FormaPagamento.Dinheiro}" Margin="0,0,10,10"/>
       <Button Content="Pix" FontSize="18" MinHeight="78" Command="{Binding SelecionarFormaCommand}" CommandParameter="{x:Static d:FormaPagamento.Pix}" Margin="0,0,10,10"/>
       <Button Content="Débito" FontSize="18" MinHeight="78" Command="{Binding SelecionarFormaCommand}" CommandParameter="{x:Static d:FormaPagamento.Debito}" Margin="0,0,10,0"/>
       <Button Content="Crédito" FontSize="18" MinHeight="78" Command="{Binding SelecionarFormaCommand}" CommandParameter="{x:Static d:FormaPagamento.Credito}" Margin="0,0,10,0"/>
      </UniformGrid>
      <TextBlock Text="Escolher uma forma ainda não registra o recebimento." FontSize="12" Foreground="{DynamicResource AjudaMuted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
     </StackPanel>
     <StackPanel Visibility="{Binding InformandoValor,Converter={StaticResource Visivel}}">
      <DockPanel Margin="0,0,0,14"><Button Content="Trocar forma" Command="{Binding TrocarFormaCommand}" DockPanel.Dock="Right"/><TextBlock Text="{Binding Fluxo.Pagamento.FormaSelecionadaDescricao}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <Label Content="Valor deste pagamento (R$)" Target="{Binding ElementName=Valor}" Padding="0,0,0,6"/><TextBox x:Name="Valor" Text="{Binding Fluxo.Pagamento.ValorPagamentoTexto,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Fluxo.DividirItens}" FontSize="28" MaxLength="14"/>
      <WrapPanel Margin="0,10,0,14"><Button Content="Saldo todo" Command="{Binding Fluxo.UsarSaldoCommand}" Margin="0,0,8,4"/><Button Content="Metade do saldo" Command="{Binding MetadeCommand}" Margin="0,0,0,4"/></WrapPanel>
      <Grid Visibility="{Binding Fluxo.Pagamento.UsaDinheiro,Converter={StaticResource Visivel}}" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Label Content="Recebido em dinheiro (R$)" Target="{Binding ElementName=Recebido}" Padding="0,0,0,6"/><TextBox x:Name="Recebido" Text="{Binding Fluxo.Pagamento.ValorRecebidoTexto,UpdateSourceTrigger=PropertyChanged}" MaxLength="14"/><TextBlock Text="Vazio significa valor exato." FontSize="11" Foreground="{DynamicResource AjudaMuted}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="Troco"/><TextBlock Text="{Binding Fluxo.Pagamento.TrocoCentavos,Converter={StaticResource Moeda}}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Grid>
      <Expander Header="Dividir por pessoas ou itens" Foreground="{DynamicResource AjudaInk}"><StackPanel Margin="0,10,0,0"><WrapPanel><Button Content="Valor livre" Command="{Binding Fluxo.ValorLivreCommand}" Margin="0,0,6,6"/><Button Content="Por pessoas" Command="{Binding Fluxo.PorPessoasCommand}" Margin="0,0,6,6"/><Button Content="Por itens" Command="{Binding Fluxo.PorItensCommand}" Margin="0,0,0,6"/></WrapPanel>
       <StackPanel Visibility="{Binding Fluxo.DividirPessoas,Converter={StaticResource Visivel}}"><Label Content="Pessoas para dividir o saldo restante" Target="{Binding ElementName=Pessoas}" Padding="0,0,0,6"/><DockPanel><TextBox x:Name="Pessoas" Text="{Binding Fluxo.Pessoas,UpdateSourceTrigger=PropertyChanged}" MaxLength="3" Width="60" DockPanel.Dock="Left" Margin="0,0,8,0"/><Button Content="Usar sugestão" Command="{Binding Fluxo.AplicarDivisaoCommand}" HorizontalAlignment="Left"/></DockPanel><TextBlock Text="{Binding Fluxo.DivisaoDescricao}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
       <StackPanel Visibility="{Binding Fluxo.DividirItens,Converter={StaticResource Visivel}}"><TextBlock Text="Selecione linhas inteiras de itens." Foreground="{DynamicResource AjudaMuted}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding Fluxo.Pagamento.ItensParaDividir}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selecionado}" IsEnabled="{Binding PodeSelecionar}" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Item.NomeProduto}" TextWrapping="Wrap"/><TextBlock Text="{Binding Item.SubtotalCentavos,Converter={StaticResource Moeda}}"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      </StackPanel></Expander>
     </StackPanel>
     <StackPanel Visibility="{Binding Conferindo,Converter={StaticResource Visivel}}">
      <TextBlock Text="Confira se o pagamento foi recebido antes de confirmar." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}" Margin="0,0,0,20"/>
      <DockPanel Margin="0,0,0,14"><TextBlock DockPanel.Dock="Right" Text="{Binding Fluxo.Pagamento.FormaSelecionadaDescricao}" FontWeight="SemiBold"/><TextBlock Text="Forma de pagamento"/></DockPanel>
      <Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="0,1,0,1" Padding="0,18"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Fluxo.Pagamento.ValorPagamentoTexto,StringFormat='R$ {0}'}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Valor a registrar" VerticalAlignment="Center"/></DockPanel></Border>
      <StackPanel Visibility="{Binding Fluxo.Pagamento.UsaDinheiro,Converter={StaticResource Visivel}}" Margin="0,14,0,0"><DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding DinheiroRecebido,StringFormat='R$ {0}'}"/><TextBlock Text="Dinheiro recebido"/></DockPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Fluxo.Pagamento.TrocoCentavos,Converter={StaticResource Moeda}}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Troco a entregar" VerticalAlignment="Center"/></DockPanel></StackPanel>
      <TextBlock Text="O Comanda registra o recebimento; a cobrança ocorre fora do sistema." Foreground="{DynamicResource AjudaMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,20,0,0"/>
     </StackPanel>
     <StackPanel Visibility="{Binding ParcelaConcluida,Converter={StaticResource Visivel}}"><TextBlock Text="Recebimento salvo" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/><TextBlock Text="{Binding UltimoRecebimento}" FontSize="20" Margin="0,10,0,0"/><TextBlock Text="O saldo ao lado já foi atualizado. Você pode receber o restante em outra forma." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}" Margin="0,16,0,0"/></StackPanel>
     <StackPanel Visibility="{Binding Quitado,Converter={StaticResource Visivel}}"><TextBlock Text="Tudo recebido" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/><TextBlock Text="{Binding Fluxo.Pagamento.TotalPagoCentavos,Converter={StaticResource Moeda}}" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,14"/><TextBlock Text="Confira o histórico ao lado e finalize o pedido para encerrar a comanda." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}"/></StackPanel>
     <StackPanel Visibility="{Binding Encerrado,Converter={StaticResource Visivel}}"><TextBlock Text="Venda finalizada" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/><TextBlock Text="A comanda foi encerrada e os recebimentos foram preservados." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}" Margin="0,12,0,0"/></StackPanel>
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Fluxo.Pagamento.Mensagem}" TextWrapping="Wrap" Margin="0,0,0,4" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding OrientacaoEtapa}" Foreground="{DynamicResource AjudaMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/><DockPanel LastChildFill="False"><Button Content="Voltar ao pedido" Click="Voltar_Click" DockPanel.Dock="Left"/><Button x:Name="AcaoPrincipal" PreviewMouseDown="Acao_MouseDown" Content="{Binding TextoAcao}" Command="{Binding AcaoCommand}" DockPanel.Dock="Right" Background="{DynamicResource Ink}" Foreground="{DynamicResource Canvas}" FontWeight="SemiBold" MinWidth="220"/><Button Content="Etapa anterior" Command="{Binding VoltarEtapaCommand}" Visibility="{Binding PodeVoltarEtapa,Converter={StaticResource Visivel}}" DockPanel.Dock="Right" Margin="0,0,10,0"/></DockPanel></StackPanel>
 </Grid>
</UserControl>
