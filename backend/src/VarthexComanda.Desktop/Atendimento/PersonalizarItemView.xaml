<Window x:Class="VarthexComanda.Desktop.Atendimento.PersonalizarItemView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Personalizar item" Width="880" Height="620" MinWidth="700" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource AjudaCanvas}" Foreground="{DynamicResource AjudaInk}" FontFamily="Segoe UI" FontSize="12">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,6"/><Setter Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Button Command="{Binding DiminuirCommand}" Width="34" Height="34" MinWidth="34" VerticalAlignment="Center" Padding="8" AutomationProperties.Name="Diminuir quantidade"><Path Data="M1 6H11" Width="12" Height="12" Stretch="None" Stroke="{DynamicResource AjudaInk}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
    <StackPanel Margin="6,0"><TextBlock Text="{Binding RotuloQuantidade}" FontSize="11" Foreground="{DynamicResource AjudaMuted}" Margin="0,0,0,3"/><TextBox x:Name="CampoQuantidade" Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="32" MinHeight="32" MaxLength="7" TextAlignment="Center" Padding="4" AutomationProperties.Name="Quantidade do produto"/></StackPanel>
    <Button Command="{Binding AumentarCommand}" Width="34" Height="34" MinWidth="34" VerticalAlignment="Center" Padding="8" AutomationProperties.Name="Aumentar quantidade"><Path Data="M6 1V11 M1 6H11" Width="12" Height="12" Stretch="None" Stroke="{DynamicResource AjudaInk}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding Produto.Nome}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0"/>
   <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Total do item" Foreground="{DynamicResource AjudaMuted}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Total}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Background="{DynamicResource AjudaSurface}"><DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource AjudaCanvas}" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="0,0,0,1" Padding="10"><TextBlock Text="Observações" FontWeight="SemiBold"/></Border>
    <TextBlock DockPanel.Dock="Bottom" Text="Até 300 caracteres. Ex.: sem cebola, molho à parte." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}" Margin="10"/>
    <TextBox x:Name="CampoObservacao" Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="300" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10" BorderThickness="0" AutomationProperties.Name="Observações do item"/>
   </DockPanel></Border>
   <Border Grid.Column="2" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Background="{DynamicResource AjudaSurface}"><DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource AjudaCanvas}" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="0,0,0,1" Padding="10"><TextBlock Text="Complementos" FontWeight="SemiBold"/></Border>
    <TextBlock Text="Este catálogo ainda não possui cadastro de complementos." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}" Margin="16" VerticalAlignment="Top"/>
   </DockPanel></Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Erro}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="AdicionarItem" Content="Adicionar item" IsDefault="True" Click="Adicionar_Click" Background="{DynamicResource AjudaAction}" Foreground="{DynamicResource AjudaActionInk}"/></StackPanel>
 </Grid>
</Window>
