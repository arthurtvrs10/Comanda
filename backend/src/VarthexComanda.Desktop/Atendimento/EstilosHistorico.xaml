<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="DataGridCell" BasedOn="{StaticResource CelulaTabela}">
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#176BD1"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource AjudaSoft}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="7,8"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="ToolTip" Value="Clique para ordenar em ordem crescente ou decrescente."/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <Path x:Name="Seta" Grid.Column="1" Data="M2,5 L5,2 L8,5 M2,8 L5,11 L8,8" Stroke="{DynamicResource RibbonSubtitle}" StrokeThickness="1.1" Width="10" Height="13" VerticalAlignment="Center"/>
    </Grid>
    <DataTemplate.Triggers>
     <DataTrigger Binding="{Binding Column,RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="{x:Null}"><Setter TargetName="Seta" Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding Column.CanUserSort,RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="False"><Setter TargetName="Seta" Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding SortDirection,RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Ascending"><Setter TargetName="Seta" Property="Data" Value="M2,8 L5,4 L8,8"/></DataTrigger>
     <DataTrigger Binding="{Binding SortDirection,RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Descending"><Setter TargetName="Seta" Property="Data" Value="M2,4 L5,8 L8,4"/></DataTrigger>
    </DataTemplate.Triggers>
   </DataTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary>