<Window x:Class="VarthexComanda.Desktop.JanelaAbertura"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Iniciando Comanda" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="CenterScreen" Width="760" Height="490" Background="#101A20"
 FontFamily="Segoe UI" Foreground="White" UseLayoutRounding="True"
 AutomationProperties.Name="Inicialização do Comanda por Varthex">
 <Viewbox Stretch="Uniform">
  <Grid Width="760" Height="490" ClipToBounds="True">
   <Image Source="pack://application:,,,/VarthexComanda;component/Assets/AberturaFundo.png"
          Stretch="UniformToFill" IsHitTestVisible="False"/>
   <Rectangle Fill="Black" Opacity="0.28" IsHitTestVisible="False"/>
   <Rectangle Height="170" VerticalAlignment="Bottom" IsHitTestVisible="False">
    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
     <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#C9000000" Offset="1"/>
    </LinearGradientBrush></Rectangle.Fill>
   </Rectangle>
   <Image x:Name="LogoAbertura" Source="pack://application:,,,/VarthexComanda;component/Assets/LogoBranca.png"
          Width="360" Height="100" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
          AutomationProperties.Name="Comanda, por Varthex"/>
   <TextBlock x:Name="EtapaAbertura" Text="Preparando o sistema…" Foreground="White" FontSize="12"
              VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="32,0,220,49"
              AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis"/>
   <ProgressBar x:Name="AtividadeAbertura" IsIndeterminate="True" Width="210" Height="3" MinHeight="0"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,0,32"
                Foreground="White" Background="#44FFFFFF" BorderThickness="0"
                AutomationProperties.Name="Inicialização em andamento"/>
   <TextBlock x:Name="VersaoAbertura" FontSize="50" FontWeight="Light" Foreground="White"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,21"/>
  </Grid>
 </Viewbox>
</Window>
