<Window x:Class="VarthexComanda.Desktop.Atendimento.PersonalizarItemView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Personalizar item" Width="880" Height="620" MinWidth="700" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource AjudaCanvas}" Foreground="{DynamicResource AjudaInk}" FontFamily="Segoe UI" FontSize="12">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visivel"/>
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,6"/><Setter Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="34"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding RotuloQuantidade}" FontSize="11" Foreground="{DynamicResource AjudaMuted}" Margin="40,0,0,4"/>
   <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Command="{Binding DiminuirCommand}" Width="34" Height="34" MinWidth="34" VerticalAlignment="Center" Padding="8" AutomationProperties.Name="Diminuir quantidade"><Path Data="M1 6H11" Width="12" Height="12" Stretch="None" Stroke="{DynamicResource AjudaInk}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
    <TextBox x:Name="CampoQuantidade" Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="34" MinHeight="34" MaxLength="7" TextAlignment="Center" VerticalContentAlignment="Center" Margin="6,0" Padding="4" AutomationProperties.Name="Quantidade do produto"/>
    <Button Command="{Binding AumentarCommand}" Width="34" Height="34" MinWidth="34" VerticalAlignment="Center" Padding="8" AutomationProperties.Name="Aumentar quantidade"><Path Data="M6 1V11 M1 6H11" Width="12" Height="12" Stretch="None" Stroke="{DynamicResource AjudaInk}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
   </StackPanel>
   <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Produto.Nome}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0"/>
   <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center"><TextBlock Text="Total do item" Foreground="{DynamicResource AjudaMuted}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Total}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Background="{DynamicResource AjudaSurface}"><DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource AjudaCanvas}" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="0,0,0,1" Height="50" Padding="10"><TextBlock VerticalAlignment="Center" Text="Observações" FontWeight="SemiBold"/></Border>
    <TextBlock DockPanel.Dock="Bottom" Text="Até 300 caracteres. Ex.: sem cebola, molho à parte." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}" Margin="10"/>
    <TextBox x:Name="CampoObservacao" Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="300" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10" BorderThickness="0" AutomationProperties.Name="Observações do item"/>
   </DockPanel></Border>
   <Border Grid.Column="2" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Background="{DynamicResource AjudaSurface}"><DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource AjudaCanvas}" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="0,0,0,1" Height="50" Padding="10"><DockPanel><Button Content="Atualizar estoque" Command="{Binding AtualizarComplementosCommand}" DockPanel.Dock="Right" MinHeight="28" FontSize="11" Padding="7,4"/><TextBlock Text="Complementos" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="12">
      <TextBlock Text="Este produto não tem complementos permitidos. Em Produtos, edite este produto e clique em Configurar complementos." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}" Visibility="{Binding SemComplementos,Converter={StaticResource Visivel}}"/>
      <ItemsControl ItemsSource="{Binding GruposComplementos}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel Margin="0,0,0,16">
         <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
         <ItemsControl ItemsSource="{Binding Opcoes}"><ItemsControl.ItemTemplate><DataTemplate>
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detalhes}" VerticalAlignment="Center" Margin="0,0,8,0"/>
           <TextBlock Grid.Column="1" Text="{Binding Preco}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding Detalhes}"/>
           <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Detalhes}">
            <Button Content="−" Command="{Binding DiminuirCommand}" Width="30" MinWidth="30" MinHeight="30" Padding="0" ToolTip="Retirar complemento" AutomationProperties.Name="{Binding Nome,StringFormat='Retirar {0}'}"/>
            <Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" MinWidth="32" Height="30" Margin="4,0"><TextBlock Text="{Binding QuantidadeSelecionada}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></Border>
            <Button Content="+" Command="{Binding AumentarCommand}" Width="30" MinWidth="30" MinHeight="30" Padding="0" ToolTip="Selecionar complemento" AutomationProperties.Name="{Binding Nome,StringFormat='Selecionar {0}'}"/>
           </StackPanel>
          </Grid>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="0,1,0,0" Padding="0,8,0,0"><StackPanel><TextBlock Text="{Binding ResumoSelecao}" FontSize="11" Foreground="{DynamicResource AjudaMuted}" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Regras}" FontSize="11" Foreground="{DynamicResource AjudaMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border>
        </StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
   </DockPanel></Border>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock Text="{Binding OrientacaoComplementos}" TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Erro}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></StackPanel>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="AdicionarItem" Content="Adicionar item" IsEnabled="{Binding PodeAdicionar}" IsDefault="True" Click="Adicionar_Click" Background="{DynamicResource ActionPrimary}" Foreground="{DynamicResource ActionPrimaryInk}"/></StackPanel>
 </Grid>
</Window>
