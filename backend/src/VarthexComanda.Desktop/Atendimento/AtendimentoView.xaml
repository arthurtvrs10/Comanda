<UserControl x:Class="VarthexComanda.Desktop.Atendimento.AtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:VarthexComanda.Desktop.Atendimento"
             xmlns:catalogo="clr-namespace:VarthexComanda.Desktop.Catalogo"
             mc:Ignorable="d"
             Background="{DynamicResource AjudaCanvas}">
    <UserControl.Resources>
        <Style x:Key="MenuPedidoContexto" TargetType="ContextMenu">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="6"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MenuPedidoItem" TargetType="MenuItem">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="Fundo" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Path x:Name="Seta" Grid.Column="1" Data="M0 0L4 4L0 8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" Width="4" Height="8" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource AjudaCanvas}" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Padding="6"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></Popup>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="HasItems" Value="True"><Setter TargetName="Seta" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource AjudaHover}"/></Trigger><Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource AjudaHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fundo" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolVisible"/>
        <local:DetalheItemPedidoConverter x:Key="DetalheItem"/>
        <Style x:Key="BotaoPedido" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="36"/><Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource AjudaCanvas}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/>
        </Style>
        <Style x:Key="NumeroPrioridade" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrioridadeNumeroNormal}"/>
            <Style.Triggers><DataTrigger Binding="{Binding ComandaAtual.Prioridade}" Value="Alta"><Setter Property="Foreground" Value="{DynamicResource PrioridadeNumeroMediana}"/></DataTrigger><DataTrigger Binding="{Binding ComandaAtual.Prioridade}" Value="Urgente"><Setter Property="Foreground" Value="{DynamicResource PrioridadeNumeroAlta}"/></DataTrigger><DataTrigger Binding="{Binding ComandaAtual.Bloqueada}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrioridadeNumeroMediana}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SituacaoPrioridade" TargetType="Button" BasedOn="{StaticResource BotaoPedido}">
            <Setter Property="Background" Value="{DynamicResource PrioridadeNormal}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers><DataTrigger Binding="{Binding ComandaAtual.Prioridade}" Value="Alta"><Setter Property="Background" Value="{DynamicResource PrioridadeMediana}"/><Setter Property="Foreground" Value="#302500"/></DataTrigger><DataTrigger Binding="{Binding ComandaAtual.Prioridade}" Value="Urgente"><Setter Property="Background" Value="{DynamicResource PrioridadeAlta}"/></DataTrigger><DataTrigger Binding="{Binding ComandaAtual.Bloqueada}" Value="True"><Setter Property="Background" Value="{DynamicResource PrioridadeMediana}"/><Setter Property="Foreground" Value="#302500"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="IconePedido" TargetType="Path">
            <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.4"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <local:NumeroComandaPesquisadoConverter x:Key="NumeroPesquisado" />
        <local:NuloParaVisibilidadeConverter x:Key="VisivelSeComandaAberta" />
        <local:NuloParaVisibilidadeInversoConverter x:Key="VisivelSeGrade" />
        <local:CentavosParaMoedaConverter x:Key="Moeda" />
        <catalogo:FotoArquivoParaImagemConverter x:Key="FotoImagem" />
        <local:ItemSelecionadoParaCorConverter x:Key="CorItemSelecionado" />
        <Style x:Key="PlaceholderBusca" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource AjudaMuted}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="PlaceholderNumero" TargetType="TextBlock" BasedOn="{StaticResource PlaceholderBusca}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NovoNumero}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlaceholderProduto" TargetType="TextBlock" BasedOn="{StaticResource PlaceholderBusca}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TextoBuscaCatalogo}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F4" Command="{Binding VerTotalCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="16">

        <Grid x:Name="PainelGrade" IsVisibleChanged="PainelGrade_IsVisibleChanged"
              Visibility="{Binding ComandaAtual, Converter={StaticResource VisivelSeGrade}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Opções ▾" Click="OpcoesGrade_Click" Padding="16,8" AutomationProperties.Name="Opções das comandas" />
                <Grid Width="260" HorizontalAlignment="Left">
                <TextBox x:Name="CampoNumeroComanda" ToolTip="Nº da comanda (Ctrl+N). Enter abre a comanda."
                         AutomationProperties.Name="Nº da comanda"
                         InputMethod.IsInputMethodEnabled="False"
                         Text="{Binding NovoNumero, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="CampoNumero_PreviewTextInput"
                         PreviewKeyDown="CampoNumero_PreviewKeyDown">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AbrirCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Nº da comanda (Ctrl+N)" Style="{StaticResource PlaceholderNumero}" />
                </Grid>
            </DockPanel>

            <ScrollViewer x:Name="RolagemComandas" Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" AutomationProperties.Name="Rolagem da grade de comandas">
                <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:GradeComandasPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="4" Height="136" Padding="6" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.AbrirOuSelecionarSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
                                        <Setter Property="Background" Value="{DynamicResource BackgroundFFFFFF}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ColorC4C4C4}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Foreground" Value="{DynamicResource Text23252A}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Aberta}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BackgroundD9822B}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ColorBF701F}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EmFechamento}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrioridadeMediana}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrioridadeMediana}" />
                                                <Setter Property="Foreground" Value="#302500" />
                                                <Setter Property="AutomationProperties.ItemStatus" Value="Em fechamento" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource NumeroPesquisado}">
                                                        <Binding Path="Numero" />
                                                        <Binding Path="DataContext.NovoNumero" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="BorderBrush" Value="#1F5FBF" />
                                                <Setter Property="BorderThickness" Value="4" />
                                                <Setter Property="AutomationProperties.ItemStatus" Value="Comanda pesquisada" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Margin="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0"><DockPanel>
                                        <Ellipse DockPanel.Dock="Right" Width="10" Height="10" Margin="6,0,0,0" Fill="{Binding CorPrioridade}" ToolTip="{Binding PrioridadeTexto}" AutomationProperties.Name="{Binding PrioridadeTexto}" />
                                        <TextBlock Text="{Binding SituacaoTexto}" FontSize="11" FontWeight="Bold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding TempoFormatado}" FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Numero, StringFormat='{}{0:00}'}"
                                               FontSize="28" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NomeCliente}" ToolTip="{Binding NomeCliente}" TextTrimming="CharacterEllipsis" FontSize="12" HorizontalAlignment="Stretch" TextAlignment="Center" />
                                    <TextBlock Text="{Binding MesaTexto}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Stretch" Margin="0,2,0,3" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding TotalFormatado}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Aberta}" Value="False">
                                                        <Setter Property="Text" Value="LIVRE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="MensagemGrade" Grid.Row="3" Text="{Binding Mensagem}" Foreground="{DynamicResource TextB23B32}" Margin="0,12,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mensagem}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding Mensagem}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid x:Name="PainelEdicao" TextElement.Foreground="{DynamicResource AjudaInk}" TextElement.FontSize="13" IsVisibleChanged="PainelEdicao_IsVisibleChanged" Visibility="{Binding ComandaAtual, Converter={StaticResource VisivelSeComandaAberta}}" Background="{DynamicResource AjudaCanvas}">
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="8,0,8,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ComandaAtual.Numero, StringFormat='{}{0:00}'}" Style="{StaticResource NumeroPrioridade}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="BotaoPrioridadePedido" Grid.Column="1" Padding="16,6" VerticalAlignment="Center" Content="{Binding SituacaoPedido}" Style="{StaticResource SituacaoPrioridade}" Click="PrioridadePedido_Click" ToolTip="{Binding DescricaoPrioridadePedido}" AutomationProperties.Name="{Binding DescricaoPrioridadePedido}"/>
                <TextBlock Grid.Column="2" Text="{Binding NumeroPedidoDestacado}" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                <Grid Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBox x:Name="CampoBusca" Background="{DynamicResource AjudaSurface}" Foreground="{DynamicResource AjudaInk}" BorderBrush="{DynamicResource AjudaLine}" MinHeight="32" FontSize="13" Padding="7,4" Text="{Binding TextoBuscaCatalogo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar produto" ToolTip="Buscar produto (Ctrl+F). Enter adiciona o primeiro resultado." IsEnabled="{Binding PodeAlterarPedido}"/>
                    <TextBlock Text="Buscar produto" Style="{StaticResource PlaceholderProduto}" FontSize="12" Margin="8,0,0,0"/>
                </Grid>
                <Button Grid.Column="4" x:Name="BotaoProdutosPedido" Click="ProdutosPedido_Click" Style="{StaticResource BotaoPedido}" IsEnabled="{Binding PodeAlterarPedido}"><StackPanel Orientation="Horizontal"><Path Data="M12 3V21 M3 12H21" Style="{StaticResource IconePedido}"/><TextBlock Text="Produtos" VerticalAlignment="Center"/></StackPanel></Button>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Padding="10">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button Tag="cliente" Click="EditarDados_Click" Style="{StaticResource BotaoPedido}" HorizontalContentAlignment="Left" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><Path Data="M12 3 A4 4 0 1 0 12 11 A4 4 0 1 0 12 3 M4 22V18 C4 12 20 12 20 18V22" Style="{StaticResource IconePedido}"/><TextBlock Text="{Binding ClientePedido}" TextTrimming="CharacterEllipsis" MaxWidth="140" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="BotaoMaisOpcoes" Click="MaisOpcoesPedido_Click" Style="{StaticResource BotaoPedido}" HorizontalContentAlignment="Left" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><Path Data="M3 5H21 M3 12H21 M3 19H21" Style="{StaticResource IconePedido}"/><TextBlock Text="Mais opções" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Content="Voltar às comandas" Command="{Binding FecharEdicaoCommand}" Style="{StaticResource BotaoPedido}" HorizontalContentAlignment="Left" ToolTip="Voltar e bloquear o acesso ao atendimento (Esc). O pedido permanece aberto."/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource AjudaMuted}" Margin="0,0,0,6"><Run Text="Iniciado em "/><Run Text="{Binding AberturaPedido, Mode=OneWay}"/></TextBlock>
                                <TextBlock Foreground="{DynamicResource AjudaMuted}" TextWrapping="Wrap" Margin="0,0,0,8"><Run Text="Criado por: "/><Run Text="{Binding AutorPedido, Mode=OneWay}"/></TextBlock>
                                <TextBlock Text="Responsável" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ResponsavelPedido" Background="{DynamicResource AjudaSurface}" Foreground="{DynamicResource AjudaInk}" BorderBrush="{DynamicResource AjudaLine}" MinHeight="32" FontSize="13" SelectionChanged="ResponsavelPedido_SelectionChanged" AutomationProperties.Name="Responsável pelo pedido" IsEnabled="{Binding PodeAlterarPedido}"/>
                                <TextBlock Text="Observação do pedido" Margin="0,10,0,4"/>
                                <TextBox x:Name="ObservacaoPedido" Background="{DynamicResource AjudaSurface}" Foreground="{DynamicResource AjudaInk}" BorderBrush="{DynamicResource AjudaLine}" FontSize="13" Padding="6" Text="{Binding ComandaAtual.Observacao, Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" MinHeight="32" MaxLength="1000" VerticalScrollBarVisibility="Auto" LostKeyboardFocus="ObservacaoPedido_LostKeyboardFocus" AutomationProperties.Name="Observação do pedido" IsEnabled="{Binding PodeAlterarPedido}"/>
                                <CheckBox x:Name="BloqueioPedido" Style="{StaticResource AlternanciaCompacta}" Content="Em fechamento" FontSize="13" Margin="0,10,0,8" IsChecked="{Binding ComandaAtual.Bloqueada, Mode=OneWay}" Click="BloqueioPedido_Click" ToolTip="Inicia o fechamento e impede alterações nos itens. Permite pagar e imprimir. Desative para voltar a alterar."/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="2" x:Name="PainelComanda" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource FocoVisivel}">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Background="{DynamicResource AjudaSurface}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Background="{DynamicResource AjudaCanvas}" LastChildFill="True">
                                <CheckBox DockPanel.Dock="Right" Content="Exibição completa" Style="{StaticResource AlternanciaCompacta}" IsChecked="{Binding ExibicaoCompleta}" VerticalAlignment="Center" Margin="8,0,12,0" FontSize="12"/>
                                <TextBlock Text="{Binding CabecalhoItens}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Itens}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="0,0,0,1" Padding="12,8" GotKeyboardFocus="LinhaItem_GotKeyboardFocus" PreviewMouseLeftButtonDown="LinhaItem_PreviewMouseLeftButtonDown">
                                                <Border.Background><MultiBinding Converter="{StaticResource CorItemSelecionado}"><Binding Path="Id"/><Binding Path="DataContext.ItemSelecionadoId" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/></MultiBinding></Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding Quantidade}" FontWeight="Bold"/><Run Text=" × "/><Run Text="{Binding NomeProduto}" FontWeight="SemiBold"/><Run Text="  [Cód. "/><Run Text="{Binding ProdutoId}"/><Run Text="]"/></TextBlock>
                                                        <StackPanel Visibility="{Binding DataContext.ExibicaoCompleta, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolVisible}}">
                                                            <TextBlock Text="{Binding Converter={StaticResource DetalheItem}}" Foreground="{DynamicResource AjudaMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding Observacao}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AjudaMuted}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SubtotalCentavos, Converter={StaticResource Moeda}}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" VerticalAlignment="Center" Height="32" BorderThickness="0" Click="OpcoesItem_Click" Tag="{Binding}" Style="{StaticResource BotaoPedido}" MinWidth="30" MinHeight="32" Padding="4" Margin="6,0,0,0" AutomationProperties.Name="Opções do item" ToolTip="Alterar quantidade ou remover item"><Path Data="M3 12 A1 1 0 1 0 5 12 A1 1 0 1 0 3 12 M11 12 A1 1 0 1 0 13 12 A1 1 0 1 0 11 12 M19 12 A1 1 0 1 0 21 12 A1 1 0 1 0 19 12" Style="{StaticResource IconePedido}" Margin="0"/></Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Nenhum item lançado. Use Produtos ou busque pelo nome." TextWrapping="Wrap" Margin="16" Foreground="{DynamicResource AjudaMuted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Itens.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <Grid Margin="12,14,50,12"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="SUBTOTAL" Margin="0,0,0,14"/><TextBlock Grid.Column="1" Text="{Binding TotalPedido}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Text="TOTAL" FontWeight="Bold" FontSize="16"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalPedido}" FontWeight="Bold" FontSize="16"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1,0,1,1" Padding="8">
                        <DockPanel LastChildFill="False">
                            <Button x:Name="BotaoImprimirPedido" DockPanel.Dock="Left" Click="ImprimirPedido_Click" Style="{StaticResource BotaoPedido}"><StackPanel Orientation="Horizontal"><Path Data="M6 8V2H18V8 M6 18H3V8H21V18H18 M6 14H18V23H6Z" Style="{StaticResource IconePedido}"/><TextBlock Text="Imprimir" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button DockPanel.Dock="Right" Content="PAGAMENTO" Command="{Binding VerTotalCommand}" Style="{StaticResource BotaoPedido}" Background="{DynamicResource AjudaAction}" Foreground="{DynamicResource AjudaActionInk}" FontWeight="Bold" Width="178" ToolTip="Pagamento da comanda (F4)"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
            <TextBlock Grid.Row="2" Text="{Binding Mensagem}" Foreground="{DynamicResource AjudaInk}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
</UserControl>
