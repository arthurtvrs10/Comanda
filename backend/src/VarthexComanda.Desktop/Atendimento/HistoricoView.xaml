<UserControl x:Class="VarthexComanda.Desktop.Atendimento.HistoricoView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI" FontSize="12" Language="pt-BR"
 Background="{DynamicResource AjudaCanvas}" Foreground="{DynamicResource AjudaInk}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="EstilosHistorico.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <Style x:Key="MensagemHistorico" TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel x:Name="PainelAcoes" Margin="0,0,0,6">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,5">
    <Label Content="Data:" Target="{Binding ElementName=DataVendas}" VerticalAlignment="Center" Padding="0,0,6,0"/>
    <DatePicker x:Name="DataVendas" SelectedDate="{Binding DataSelecionada}" Width="135" MinHeight="36" FontSize="12" Padding="5,3" AutomationProperties.Name="Data das vendas"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,5">
    <Label Content="Comanda:" Target="{Binding ElementName=CampoBuscaNumero}" VerticalAlignment="Center" Padding="0,0,6,0"/>
    <TextBox x:Name="CampoBuscaNumero" Width="95" MinHeight="36" FontSize="12" Padding="5,3" ToolTip="Buscar comanda (Ctrl+F)" AutomationProperties.Name="Buscar comanda" Text="{Binding TextoBuscaNumero, UpdateSourceTrigger=PropertyChanged}"/>
   </StackPanel>
  </WrapPanel>
  <StackPanel Grid.Row="1"><TextBlock Text="{Binding Mensagem}" Style="{StaticResource MensagemHistorico}" Foreground="{DynamicResource AjudaMuted}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding MensagemListaVazia}" Style="{StaticResource MensagemHistorico}" Foreground="{DynamicResource AjudaMuted}" TextWrapping="Wrap" Margin="0,0,0,5"/>
  </StackPanel>
  <DataGrid x:Name="TabelaVendas" Grid.Row="2" ItemsSource="{Binding Vendas}" SelectedItem="{Binding VendaSelecionada}"
   AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
   SelectionMode="Single" SelectionUnit="FullRow" RowHeight="34" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
   Background="{DynamicResource AjudaSurface}" Foreground="{DynamicResource AjudaInk}" RowBackground="{DynamicResource AjudaSurface}" AlternatingRowBackground="{DynamicResource AjudaCanvas}"
   BorderBrush="{DynamicResource AjudaLine}" HorizontalGridLinesBrush="{DynamicResource AjudaLine}" BorderThickness="1" RowHeaderWidth="0"
   MouseDoubleClick="Tabela_DoubleClick" PreviewKeyDown="Tabela_KeyDown" AutomationProperties.Name="Histórico de vendas">
   <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="Foreground" Value="{DynamicResource SelectionInk}"/></Trigger></Style.Triggers>
   </Style></DataGrid.RowStyle>
  </DataGrid>
  <Border Grid.Row="3" Background="{DynamicResource AjudaSurface}" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1,0,1,1" Padding="10,7">
   <WrapPanel HorizontalAlignment="Left">
    <TextBlock Text="{Binding QuantidadeExibida, StringFormat='Exibidas: {0}'}" Margin="0,0,16,0"/>
    <TextBlock Text="{Binding QuantidadeVendas, StringFormat='Vendas do dia: {0}'}" Margin="0,0,16,0"/>
    <TextBlock x:Name="ResumoDia" FontWeight="SemiBold"/>
   </WrapPanel>
  </Border>
  <CheckBox x:Name="AutoAjustarColunas" Grid.Row="4" Content="Auto ajustar colunas" Style="{StaticResource AlternanciaCompacta}" IsChecked="True" Margin="0,5,0,0" Checked="AutoAjustar_Changed" Unchecked="AutoAjustar_Changed"/>
 </Grid>
</UserControl>
