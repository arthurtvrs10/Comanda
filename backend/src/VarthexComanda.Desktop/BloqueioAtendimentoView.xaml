<UserControl x:Class="VarthexComanda.Desktop.BloqueioAtendimentoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="True" KeyboardNavigation.TabNavigation="Cycle">
 <Grid>
  <Border Background="#6617252C" IsHitTestVisible="False"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid MinHeight="520">
    <Border Width="390" MaxWidth="390" Margin="20,28" Padding="28" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Border.Resources>
      <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
      <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="0,0,0,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
      <Style TargetType="TextBox"><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="15"/><Setter Property="MinHeight" Value="46"/></Style>
      <Style TargetType="PasswordBox"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="15"/><Setter Property="MinHeight" Value="46"/></Style>
     </Border.Resources>
     <StackPanel>
      <Image Source="{DynamicResource MarcaLogo}" Width="155" Height="45" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,20" AutomationProperties.Name="Comanda por Varthex"/>
      <TextBlock x:Name="Titulo" Text="Sistema bloqueado" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock x:Name="Instrucao" Text="Informe seu login e sua senha para continuar." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}" FontSize="14" Margin="0,8,0,20"/>
      <StackPanel x:Name="CamposLogin">
       <Label Content="Login" Target="{Binding ElementName=Login}"/>
       <Grid Margin="0,0,0,18">
        <TextBox x:Name="Login" MaxLength="60" AutomationProperties.Name="Login"/>
        <TextBlock TextAlignment="Center" Text="Digite seu login" Foreground="{DynamicResource AjudaMuted}" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Login}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>
      </StackPanel>
      <Label x:Name="RotuloSenha" Content="Senha" Target="{Binding ElementName=Senha}"/>
      <Grid>
      <PasswordBox x:Name="Senha" MaxLength="128" AutomationProperties.Name="Senha" PasswordChanged="Senha_Changed"/>
      <TextBox x:Name="SenhaVisivel" MaxLength="128" Visibility="Collapsed" AutomationProperties.Name="Senha visível" TextChanged="SenhaVisivel_Changed"/>
      <TextBlock x:Name="PlaceholderSenha" TextAlignment="Center" Text="Digite sua senha" Foreground="{DynamicResource AjudaMuted}" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"/>
      </Grid>
      <CheckBox x:Name="MostrarSenha" Style="{DynamicResource AlternanciaCompacta}" Content="Mostrar senha" Foreground="{DynamicResource AjudaMuted}" FontSize="12" MinHeight="28" Margin="0,8,0,0" Checked="MostrarSenha_Click" Unchecked="MostrarSenha_Click"/>
      <TextBlock x:Name="Mensagem" Foreground="{DynamicResource TextA12822}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="BotaoEntrar" Content="Entrar no sistema" Click="Entrar_Click" MinHeight="40" Margin="0,18,0,0" Style="{DynamicResource BotaoPrimario}" FontSize="13" FontWeight="SemiBold"/>
      <Button x:Name="BotaoConfigurar" Content="Cancelar configuração" Visibility="Collapsed" Click="Configurar_Click" Background="Transparent" Foreground="{DynamicResource AjudaMuted}" BorderThickness="0" Margin="0,8,0,0"/>
      <Button Content="Esqueci minha senha" Click="Recuperar_Click" Background="Transparent" Foreground="{DynamicResource AjudaMuted}" BorderThickness="0" FontSize="12" MinHeight="30" Margin="0,8,0,0"/>
      <TextBlock Text="Não consegue entrar? Fale com o gestor." Foreground="{DynamicResource AjudaMuted}" TextAlignment="Center" FontSize="12" Margin="0,18,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </Grid>
  </ScrollViewer>
 </Grid>
</UserControl>