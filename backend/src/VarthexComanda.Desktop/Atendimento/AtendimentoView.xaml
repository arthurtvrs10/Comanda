<UserControl x:Class="VarthexComanda.Desktop.Atendimento.AtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:VarthexComanda.Desktop.Atendimento"
             xmlns:domain="clr-namespace:VarthexComanda.Domain;assembly=VarthexComanda.Domain"
             xmlns:catalogo="clr-namespace:VarthexComanda.Desktop.Catalogo"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundF2F2F0}">
    <UserControl.Resources>
        <local:NumeroComandaPesquisadoConverter x:Key="NumeroPesquisado" />
        <Style x:Key="BotaoPainelComanda" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color87988E}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                            <Grid>
                                <Border x:Name="HoverFeedback" Background="{DynamicResource HoverOverlay}" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Color1F5FBF}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /><Setter TargetName="HoverFeedback" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HoverFeedback" Property="Opacity" Value="0"/>
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource BackgroundE1E5E2}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ColorC4CCC6}" />
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="#59645D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AcaoComanda" TargetType="Button" BasedOn="{StaticResource BotaoPainelComanda}">
            <Setter Property="Background" Value="{DynamicResource BackgroundE1E8E4}" />
            <Setter Property="Foreground" Value="{DynamicResource Text263C32}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="78" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="IconeAcao" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <local:NuloParaVisibilidadeConverter x:Key="VisivelSeComandaAberta" />
        <local:NuloParaVisibilidadeInversoConverter x:Key="VisivelSeGrade" />
        <local:CentavosParaMoedaConverter x:Key="Moeda" />
        <local:CategoriaSelecionadaParaCorConverter x:Key="CorCategoria" />
        <catalogo:FotoArquivoParaImagemConverter x:Key="FotoImagem" />
        <local:ItemSelecionadoParaCorConverter x:Key="CorItemSelecionado" />
        <Style x:Key="PlaceholderBusca" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Text8A8A86}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="PlaceholderNumero" TargetType="TextBlock" BasedOn="{StaticResource PlaceholderBusca}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NovoNumero}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlaceholderProduto" TargetType="TextBlock" BasedOn="{StaticResource PlaceholderBusca}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TextoBuscaCatalogo}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F4" Command="{Binding VerTotalCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="16">

        <Grid x:Name="PainelGrade" IsVisibleChanged="PainelGrade_IsVisibleChanged"
              Visibility="{Binding ComandaAtual, Converter={StaticResource VisivelSeGrade}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Opções ▾" Click="OpcoesGrade_Click" Padding="16,8" AutomationProperties.Name="Opções das comandas" />
                <Grid Width="260" HorizontalAlignment="Left">
                <TextBox x:Name="CampoNumeroComanda" ToolTip="Nº da comanda (Ctrl+N). Enter abre a comanda."
                         AutomationProperties.Name="Nº da comanda"
                         InputMethod.IsInputMethodEnabled="False"
                         Text="{Binding NovoNumero, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="CampoNumero_PreviewTextInput"
                         PreviewKeyDown="CampoNumero_PreviewKeyDown">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AbrirCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Nº da comanda (Ctrl+N)" Style="{StaticResource PlaceholderNumero}" />
                </Grid>
            </DockPanel>

            <ScrollViewer x:Name="RolagemComandas" Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" AutomationProperties.Name="Rolagem da grade de comandas">
                <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:GradeComandasPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="4" Height="136" Padding="6" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.AbrirOuSelecionarSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
                                        <Setter Property="Background" Value="{DynamicResource BackgroundFFFFFF}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ColorC4C4C4}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Foreground" Value="{DynamicResource Text23252A}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Aberta}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BackgroundD9822B}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ColorBF701F}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource NumeroPesquisado}">
                                                        <Binding Path="Numero" />
                                                        <Binding Path="DataContext.NovoNumero" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="BorderBrush" Value="#1F5FBF" />
                                                <Setter Property="BorderThickness" Value="4" />
                                                <Setter Property="AutomationProperties.ItemStatus" Value="Comanda pesquisada" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Margin="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0"><DockPanel>
                                        <Ellipse DockPanel.Dock="Right" Width="10" Height="10" Margin="6,0,0,0" Fill="{Binding CorPrioridade}" ToolTip="{Binding PrioridadeTexto}" AutomationProperties.Name="{Binding PrioridadeTexto}" />
                                        <TextBlock Text="{Binding PrioridadeTexto}" FontSize="11" FontWeight="Bold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding TempoFormatado}" FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Numero, StringFormat='{}{0:00}'}"
                                               FontSize="28" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NomeCliente}" ToolTip="{Binding NomeCliente}" TextTrimming="CharacterEllipsis" FontSize="12" HorizontalAlignment="Stretch" TextAlignment="Center" />
                                    <TextBlock Text="{Binding MesaTexto}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Stretch" Margin="0,2,0,3" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding TotalFormatado}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Aberta}" Value="False">
                                                        <Setter Property="Text" Value="LIVRE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="MensagemGrade" Grid.Row="3" Text="{Binding Mensagem}" Foreground="{DynamicResource TextB23B32}" Margin="0,12,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mensagem}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding Mensagem}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid x:Name="PainelEdicao" IsVisibleChanged="PainelEdicao_IsVisibleChanged" SizeChanged="PainelEdicao_SizeChanged"
              Visibility="{Binding ComandaAtual, Converter={StaticResource VisivelSeComandaAberta}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColunaCatalogo" Width="1*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,12" KeyboardNavigation.TabIndex="3">
                <Button Content="Voltar às comandas" Command="{Binding FecharEdicaoCommand}"
                        Padding="14,6" ToolTip="Voltar ao menu e bloquear o acesso (Esc). A comanda permanece aberta." />
                <TextBlock Text="Ao sair, o atendimento será bloqueado." Foreground="{DynamicResource Text666666}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="{DynamicResource BackgroundC4C4C4}" />

            <Grid x:Name="PainelMenu" Grid.Row="1" Grid.Column="0" KeyboardNavigation.TabIndex="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="MENU" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Text4A4A47}" Margin="0,0,0,8" />

                <!-- Ordem de Tab da tela: busca (0) > categorias (1) > cards do menu (2) > itens da comanda > Voltar > Cancelar > Finalizar -->
                <StackPanel Grid.Row="1" Margin="0,0,0,8" KeyboardNavigation.TabIndex="0">
                <Grid>
                    <TextBox x:Name="CampoBusca" ToolTip="Buscar produto (Ctrl+F). Enter adiciona o primeiro resultado."
                             AutomationProperties.Name="Buscar produto"
                             Text="{Binding TextoBuscaCatalogo, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Buscar produto (Ctrl+F)" Style="{StaticResource PlaceholderProduto}" />
                </Grid>
                    <TextBlock Text="Observação para o próximo produto" Margin="0,8,0,4" Foreground="{DynamicResource Text4A4A47}" />
                    <TextBox Text="{Binding ObservacaoNovoItem, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                             MinHeight="46" AutomationProperties.Name="Observação para o próximo produto"
                             ToolTip="Ex.: sem cebola. Será aplicada ao próximo produto adicionado e depois limpa." />
                </StackPanel>

                <ScrollViewer Grid.Row="2" KeyboardNavigation.TabIndex="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ProdutosCatalogo}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="128" Height="128" Margin="0,0,8,8" Padding="0"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        Background="{DynamicResource BackgroundFFFFFF}" BorderBrush="{DynamicResource ColorC4C4C4}" BorderThickness="1"
                                        Command="{Binding DataContext.AdicionarProdutoAoItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Background="{DynamicResource BackgroundE1E8E4}" ClipToBounds="True">
                                            <Image Source="{Binding FotoArquivo, Converter={StaticResource FotoImagem}}" Stretch="UniformToFill" />
                                        </Grid>
                                        <Border Grid.Row="1" BorderBrush="{DynamicResource ColorC4C4C4}" BorderThickness="0,1,0,0" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PrecoCentavos, Converter={StaticResource Moeda}}"
                                                           FontSize="10.5" Foreground="{DynamicResource Text6B6B67}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <DockPanel Grid.Row="3" Margin="0,8,0,0" KeyboardNavigation.TabIndex="1">
                    <Button DockPanel.Dock="Left" Content="Todas" Width="76" Height="48" Margin="0,0,6,0" Padding="4" FontSize="13"
                            Command="{Binding LimparFiltroCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
                                <Setter Property="Background" Value="{DynamicResource BackgroundFFFFFF}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ColorC4C4C4}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CategoriaCatalogo}" Value="{x:Null}">
                                        <Setter Property="Background" Value="{DynamicResource BackgroundEDEDEA}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Categorias}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="48" Margin="0,0,6,0" Padding="4"
                                        Command="{Binding DataContext.SelecionarCategoriaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Background>
                                        <MultiBinding Converter="{StaticResource CorCategoria}">
                                            <Binding />
                                            <Binding Path="DataContext.CategoriaCatalogo" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </Button.Background>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ColorC4C4C4}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Content" Value="{Binding Nome}" />
                                            <Setter Property="FontSize" Value="13" />
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>

            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" KeyboardNavigation.TabIndex="1" x:Name="PainelComanda" Focusable="True" KeyboardNavigation.IsTabStop="False"
                  FocusVisualStyle="{StaticResource FocoVisivel}" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border Background="{DynamicResource Background263C32}" Padding="10,7" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding ComandaAtual.Numero, StringFormat='COMANDA {0}'}" Foreground="White" FontWeight="Bold" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding ComandaAtual.Id, StringFormat='#{0:0000}'}" Foreground="{DynamicResource TextD6EADF}" FontWeight="SemiBold" ToolTip="Identificador único da comanda" />
                                <TextBlock Text="{Binding ComandaAtual.CodigoPedido, StringFormat='Pedido {0}'}" Foreground="White" FontWeight="SemiBold" Margin="12,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers><DataTrigger Binding="{Binding ComandaAtual.CodigoPedido}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </WrapPanel>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{Binding CorPrioridadeAtual}" Stroke="{DynamicResource ColorFFFFFF}" StrokeThickness="1" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding ComandaAtual.Prioridade}" Foreground="White" FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Text="{Binding TempoComandaAtual}" Foreground="White" FontWeight="Bold" ToolTip="Tempo desde a abertura" AutomationProperties.Name="Tempo desde a abertura" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pessoas" Foreground="White" FontWeight="Bold" />
                                <TextBlock Text="{Binding ComandaAtual.QuantidadePessoas}" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Cliente" Foreground="White" FontWeight="Bold" />
                                <TextBlock Text="{Binding ComandaAtual.NomeCliente, TargetNullValue='Não informado'}" ToolTip="{Binding ComandaAtual.NomeCliente}" TextTrimming="CharacterEllipsis" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <WrapPanel>
                    <Button Tag="mesa" Click="EditarDados_Click" Margin="0,0,0,8" MinHeight="46" Padding="12,4"
                            HorizontalAlignment="Left" AutomationProperties.Name="Definir mesa"
                            ToolTip="Definir ou alterar a mesa; vazio para balcão">
                        <TextBlock Text="{Binding ComandaAtual.NumeroMesa, StringFormat='Mesa {0} · alterar', TargetNullValue='Balcão · definir mesa'}" />
                    </Button>
<Button Content="Origem do cliente" Click="OrigemCliente_Click" Margin="8,0,0,8"/><Button Content="Imprimir conta" Click="ImprimirConta_Click" Margin="8,0,0,8"/>
</WrapPanel>
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="{DynamicResource ColorC4CCC6}" BorderThickness="1" Background="{DynamicResource BackgroundFFFFFF}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                    
                        <Grid Grid.Row="0" Background="{DynamicResource BackgroundE1E8E4}" Margin="0,0,17,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="188" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DESCRIÇÃO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text4A4A47}"
                                       Margin="8,6" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="QTD." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text4A4A47}"
                                       Margin="0,6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="PREÇO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text4A4A47}"
                                       Margin="0,6,8,6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="TOTAL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text4A4A47}"
                                       Margin="0,6,8,6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Itens}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0" Padding="0,4"
                                                GotKeyboardFocus="LinhaItem_GotKeyboardFocus"
                                                PreviewMouseLeftButtonDown="LinhaItem_PreviewMouseLeftButtonDown">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource CorItemSelecionado}">
                                                    <Binding Path="Id" />
                                                    <Binding Path="DataContext.ItemSelecionadoId" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="188" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding NomeProduto}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Observacao}" FontSize="12" Foreground="{DynamicResource Text4A4A47}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding PrecoUnitarioCentavos, Converter={StaticResource Moeda}}" FontSize="14"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding SubtotalCentavos, Converter={StaticResource Moeda}}" FontSize="14"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Button Content="−" Width="44" Height="44" FontSize="20" FontWeight="Bold"
                                                            Command="{Binding DataContext.DiminuirQuantidadeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                    <Button Content="+" Width="44" Height="44" FontSize="20" FontWeight="Bold"
                                                            Command="{Binding DataContext.AumentarQuantidadeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                    <Button Content="Excluir" Foreground="{DynamicResource TextB23B32}" Height="44" MinHeight="44" Padding="12,0"
                                                            Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,8,0,6">
                    <DockPanel Margin="4,0,4,10">
                        <TextBlock Text="TOTAL DA COMANDA" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Text666666}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ComandaAtual.TotalCentavos, Converter={StaticResource Moeda}}" FontWeight="Bold" FontSize="26" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                    </DockPanel>
                    <UniformGrid Columns="5">
                        <Button Click="AlterarPrioridade_Click" Style="{StaticResource AcaoComanda}" Margin="0,0,8,0" AutomationProperties.Name="Alterar prioridade">
                            <StackPanel>
                                <Path Data="M 6,17 L 7,15 L 7,9 C 7,3 17,3 17,9 L 17,15 L 19,17 Z M 10,20 L 15,20 M 12,2 L 12,4" Style="{StaticResource IconeAcao}" />
                                <TextBlock Text="Alterar&#10;prioridade" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="mover" Click="EditarDados_Click" Style="{StaticResource AcaoComanda}" Margin="0,0,8,0" AutomationProperties.Name="Mover para">
                            <StackPanel>
                                <Path Data="M 12,1 L 12,23 M 1,12 L 23,12 M 8,5 L 12,1 L 16,5 M 8,19 L 12,23 L 16,19 M 5,8 L 1,12 L 5,16 M 19,8 L 23,12 L 19,16" Style="{StaticResource IconeAcao}" />
                                <TextBlock Text="Mover&#10;para" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="pessoas" Click="EditarDados_Click" Style="{StaticResource AcaoComanda}" Margin="0,0,8,0" AutomationProperties.Name="Alterar quantidade de pessoas">
                            <StackPanel>
                                <Path Data="M 8,3 A 3,3 0 1 0 8,9 A 3,3 0 1 0 8,3 M 1,23 L 1,17 C 1,11 15,11 15,17 L 15,23 M 17,4 A 3,3 0 0 1 17,10 M 18,14 C 23,14 23,17 23,22" Style="{StaticResource IconeAcao}" />
                                <TextBlock Text="Alterar&#10;pessoas" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="cliente" Click="EditarDados_Click" Style="{StaticResource AcaoComanda}" Margin="0,0,8,0" AutomationProperties.Name="Adicionar ou alterar pessoa">
                            <StackPanel>
                                <Path Data="M 9,2 A 4,4 0 1 0 9,10 A 4,4 0 1 0 9,2 M 1,23 L 1,18 C 1,12 17,12 17,18 L 17,23 M 20,3 L 20,11 M 16,7 L 24,7" Style="{StaticResource IconeAcao}" />
                                <TextBlock Text="Adicionar&#10;pessoa" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelarComandaAtualCommand}" Style="{StaticResource AcaoComanda}"
                                Foreground="{DynamicResource TextB23B32}" BorderBrush="{DynamicResource ColorB23B32}" Background="{DynamicResource BackgroundFFF5F3}"
                                AutomationProperties.Name="Cancelar comanda" ToolTip="Cancelar o atendimento sem registrar pagamento. Requer confirmação.">
                            <StackPanel>
                                <Path Data="M 5,5 L 19,19 M 19,5 L 5,19" Style="{StaticResource IconeAcao}" />
                                <TextBlock Text="Cancelar&#10;comanda" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BotaoPainelComanda}" Content="Concluir lançamento" Command="{Binding FecharEdicaoCommand}" Background="{DynamicResource Background23262B}" Foreground="White" Height="86" FontWeight="Bold" Margin="0,0,8,0" Padding="8" ToolTip="Manter a comanda aberta e bloquear o atendimento" />
                        <Button Style="{StaticResource BotaoPainelComanda}" Grid.Column="1" Content="Pagar" Command="{Binding VerTotalCommand}" Background="{DynamicResource Background245640}" Foreground="White" Height="86" FontWeight="Bold" Padding="8" ToolTip="Finalizar comanda (F4)" />
                    </Grid>

                </StackPanel>

                <TextBlock Grid.Row="4" Text="{Binding Mensagem}" Foreground="{DynamicResource TextB23B32}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
