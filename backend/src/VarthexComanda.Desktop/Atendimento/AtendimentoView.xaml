<UserControl x:Class="VarthexComanda.Desktop.Atendimento.AtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:VarthexComanda.Desktop.Atendimento"
             xmlns:domain="clr-namespace:VarthexComanda.Domain;assembly=VarthexComanda.Domain"
             xmlns:catalogo="clr-namespace:VarthexComanda.Desktop.Catalogo"
             mc:Ignorable="d"
             Background="#F2F2F0">
    <UserControl.Resources>
        <Style x:Key="AcaoComanda" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C4C4C4" />
            <Setter Property="Foreground" Value="#23252A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="78" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="IconeAcao" TargetType="Path">
            <Setter Property="Stroke" Value="#23252A" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <local:NuloParaVisibilidadeConverter x:Key="VisivelSeComandaAberta" />
        <local:NuloParaVisibilidadeInversoConverter x:Key="VisivelSeGrade" />
        <local:CentavosParaMoedaConverter x:Key="Moeda" />
        <local:CategoriaSelecionadaParaCorConverter x:Key="CorCategoria" />
        <catalogo:FotoArquivoParaImagemConverter x:Key="FotoImagem" />
        <local:ItemSelecionadoParaCorConverter x:Key="CorItemSelecionado" />
        <Style x:Key="PlaceholderBusca" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="#8A8A86" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="PlaceholderNumero" TargetType="TextBlock" BasedOn="{StaticResource PlaceholderBusca}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NovoNumero}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlaceholderProduto" TargetType="TextBlock" BasedOn="{StaticResource PlaceholderBusca}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TextoBuscaCatalogo}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F4" Command="{Binding VerTotalCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="16">

        <Grid x:Name="PainelGrade" IsVisibleChanged="PainelGrade_IsVisibleChanged"
              Visibility="{Binding ComandaAtual, Converter={StaticResource VisivelSeGrade}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="COMANDAS" FontWeight="Bold" FontSize="12" Foreground="#4A4A47" Margin="0,0,0,10" />

            <Grid Grid.Row="1" Margin="0,0,0,12" Width="260" HorizontalAlignment="Left">
                <TextBox x:Name="CampoNumeroComanda" ToolTip="Nº da comanda (Ctrl+N). Enter abre a comanda."
                         AutomationProperties.Name="Nº da comanda"
                         InputMethod.IsInputMethodEnabled="False"
                         Text="{Binding NovoNumero, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="CampoNumero_PreviewTextInput"
                         PreviewKeyDown="CampoNumero_PreviewKeyDown">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AbrirCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Nº da comanda (Ctrl+N)" Style="{StaticResource PlaceholderNumero}" />
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="4" Height="128" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.AbrirOuSelecionarSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="#C4C4C4" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Foreground" Value="#23252A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Aberta}" Value="True">
                                                <Setter Property="Background" Value="#D9822B" />
                                                <Setter Property="BorderBrush" Value="#BF701F" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <Ellipse DockPanel.Dock="Right" Width="10" Height="10" Margin="6,0,0,0" Fill="{Binding CorPrioridade}" ToolTip="{Binding PrioridadeTexto}" AutomationProperties.Name="{Binding PrioridadeTexto}" />
                                        <TextBlock Text="{Binding PrioridadeTexto}" FontSize="11" FontWeight="Bold" />
                                        <TextBlock Text="{Binding TempoFormatado}" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Numero, StringFormat='{}{0:00}'}"
                                               FontSize="28" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NomeCliente}" ToolTip="{Binding NomeCliente}" TextTrimming="CharacterEllipsis" FontSize="13" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding TotalFormatado}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Aberta}" Value="False">
                                                        <Setter Property="Text" Value="LIVRE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Text="{Binding Mensagem}" Foreground="#B23B32" Margin="0,12,0,0" />
        </Grid>

        <Grid x:Name="PainelEdicao" IsVisibleChanged="PainelEdicao_IsVisibleChanged"
              Visibility="{Binding ComandaAtual, Converter={StaticResource VisivelSeComandaAberta}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12" KeyboardNavigation.TabIndex="3">
                <Button DockPanel.Dock="Left" Content="Voltar às comandas" Command="{Binding FecharEdicaoCommand}"
                        Padding="14,6" ToolTip="Voltar ao menu e bloquear o acesso (Esc). A comanda permanece aberta." />
                <Button DockPanel.Dock="Right" Content="Cancelar comanda" Command="{Binding CancelarComandaAtualCommand}"
                        Foreground="#B23B32" BorderBrush="#B23B32" BorderThickness="1" Background="Transparent"
                        Padding="14,6" ToolTip="Cancelar o atendimento sem registrar pagamento. Requer confirmação." />
                <TextBlock Text="Ao sair, o atendimento será bloqueado." Foreground="#666666" VerticalAlignment="Center" Margin="16,0" />
            </DockPanel>

            <Border Grid.Row="1" Grid.Column="1" Background="#C4C4C4" />

            <Grid x:Name="PainelMenu" Grid.Row="1" Grid.Column="0" KeyboardNavigation.TabIndex="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="MENU" FontWeight="Bold" FontSize="12" Foreground="#4A4A47" Margin="0,0,0,8" />

                <!-- Ordem de Tab da tela: busca (0) > categorias (1) > cards do menu (2) > itens da comanda > Voltar > Cancelar > Finalizar -->
                <Grid Grid.Row="1" Margin="0,0,0,8" KeyboardNavigation.TabIndex="0">
                    <TextBox x:Name="CampoBusca" ToolTip="Buscar produto (Ctrl+F). Enter adiciona o primeiro resultado."
                             AutomationProperties.Name="Buscar produto"
                             Text="{Binding TextoBuscaCatalogo, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Buscar produto (Ctrl+F)" Style="{StaticResource PlaceholderProduto}" />
                </Grid>

                <ScrollViewer Grid.Row="2" KeyboardNavigation.TabIndex="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ProdutosCatalogo}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="128" Height="128" Margin="0,0,8,8" Padding="0"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        Background="White" BorderBrush="#C4C4C4" BorderThickness="1"
                                        Command="{Binding DataContext.AdicionarProdutoAoItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Background="#EDEDEA" ClipToBounds="True">
                                            <Image Source="{Binding FotoArquivo, Converter={StaticResource FotoImagem}}" Stretch="UniformToFill" />
                                        </Grid>
                                        <Border Grid.Row="1" BorderBrush="#C4C4C4" BorderThickness="0,1,0,0" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PrecoCentavos, Converter={StaticResource Moeda}}"
                                                           FontSize="10.5" Foreground="#6B6B67" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <DockPanel Grid.Row="3" Margin="0,8,0,0" KeyboardNavigation.TabIndex="1">
                    <Button DockPanel.Dock="Left" Content="Todas" Width="76" Height="48" Margin="0,0,6,0" Padding="4" FontSize="13"
                            Command="{Binding LimparFiltroCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderBrush" Value="#C4C4C4" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CategoriaCatalogo}" Value="{x:Null}">
                                        <Setter Property="Background" Value="#EDEDEA" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Categorias}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="48" Margin="0,0,6,0" Padding="4"
                                        Command="{Binding DataContext.SelecionarCategoriaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Background>
                                        <MultiBinding Converter="{StaticResource CorCategoria}">
                                            <Binding />
                                            <Binding Path="DataContext.CategoriaCatalogo" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </Button.Background>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
                                            <Setter Property="BorderBrush" Value="#C4C4C4" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Content" Value="{Binding Nome}" />
                                            <Setter Property="FontSize" Value="13" />
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="2" KeyboardNavigation.TabIndex="1" x:Name="PainelComanda" Focusable="True" KeyboardNavigation.IsTabStop="False"
                  FocusVisualStyle="{StaticResource FocoVisivel}" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border Background="#818181" Padding="10,7" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ComandaAtual.Numero, StringFormat='COMANDA {0}'}" Foreground="Black" FontWeight="Bold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{Binding CorPrioridadeAtual}" Stroke="White" StrokeThickness="1" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding ComandaAtual.Prioridade}" Foreground="Black" FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Text="{Binding TempoComandaAtual}" Foreground="Black" FontWeight="Bold" ToolTip="Tempo desde a abertura" AutomationProperties.Name="Tempo desde a abertura" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pessoas" Foreground="Black" FontWeight="Bold" />
                                <TextBlock Text="{Binding ComandaAtual.QuantidadePessoas}" Foreground="Black" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Cliente" Foreground="Black" FontWeight="Bold" />
                                <TextBlock Text="{Binding ComandaAtual.NomeCliente, TargetNullValue='Não informado'}" ToolTip="{Binding ComandaAtual.NomeCliente}" TextTrimming="CharacterEllipsis" Foreground="Black" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ComandaAtual.Id, StringFormat='Comanda #{0:0000}'}" FontWeight="Bold" Foreground="#666666" VerticalAlignment="Center" />
                        <TextBlock Text="Consumo da mesa" FontSize="24" FontWeight="Bold" Foreground="#23252A" />
                    </DockPanel>
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="#C4C4C4" BorderThickness="1" Background="#F2F2F0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                    
                        <Grid Grid.Row="0" Background="#EDEDEA" Margin="0,0,17,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="188" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DESCRIÇÃO" FontSize="12" FontWeight="Bold" Foreground="#4A4A47"
                                       Margin="8,6" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="QTD." FontSize="12" FontWeight="Bold" Foreground="#4A4A47"
                                       Margin="0,6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="PREÇO" FontSize="12" FontWeight="Bold" Foreground="#4A4A47"
                                       Margin="0,6,8,6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="TOTAL" FontSize="12" FontWeight="Bold" Foreground="#4A4A47"
                                       Margin="0,6,8,6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Itens}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0" Padding="0,4"
                                                GotKeyboardFocus="LinhaItem_GotKeyboardFocus"
                                                PreviewMouseLeftButtonDown="LinhaItem_PreviewMouseLeftButtonDown">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource CorItemSelecionado}">
                                                    <Binding Path="Id" />
                                                    <Binding Path="DataContext.ItemSelecionadoId" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="188" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding NomeProduto}" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding PrecoUnitarioCentavos, Converter={StaticResource Moeda}}" FontSize="14"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding SubtotalCentavos, Converter={StaticResource Moeda}}" FontSize="14"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Button Content="−" Width="44" Height="44" FontSize="20" FontWeight="Bold"
                                                            Command="{Binding DataContext.DiminuirQuantidadeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                    <Button Content="+" Width="44" Height="44" FontSize="20" FontWeight="Bold"
                                                            Command="{Binding DataContext.AumentarQuantidadeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                    <Button Content="Excluir" Foreground="#B23B32" Height="44" MinHeight="44" Padding="12,0"
                                                            Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,8,0,6">
                    <DockPanel Margin="4,0,4,10">
                        <TextBlock Text="TOTAL DA COMANDA" FontWeight="Bold" FontSize="12" Foreground="#666666" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ComandaAtual.TotalCentavos, Converter={StaticResource Moeda}}" FontWeight="Bold" FontSize="26" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                    </DockPanel>
                    <UniformGrid Columns="4">
                        <Button Click="AlterarPrioridade_Click" Style="{StaticResource AcaoComanda}" Margin="0,0,8,0" AutomationProperties.Name="Alterar prioridade">
                            <StackPanel>
                                <Path Data="M 6,17 L 7,15 L 7,9 C 7,3 17,3 17,9 L 17,15 L 19,17 Z M 10,20 L 15,20 M 12,2 L 12,4" Style="{StaticResource IconeAcao}" />
                                <TextBlock Text="Alterar&#10;prioridade" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="mover" Click="EditarDados_Click" Style="{StaticResource AcaoComanda}" Margin="0,0,8,0" AutomationProperties.Name="Mover para">
                            <StackPanel>
                                <Path Data="M 12,1 L 12,23 M 1,12 L 23,12 M 8,5 L 12,1 L 16,5 M 8,19 L 12,23 L 16,19 M 5,8 L 1,12 L 5,16 M 19,8 L 23,12 L 19,16" Style="{StaticResource IconeAcao}" />
                                <TextBlock Text="Mover&#10;para" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="pessoas" Click="EditarDados_Click" Style="{StaticResource AcaoComanda}" Margin="0,0,8,0" AutomationProperties.Name="Alterar quantidade de pessoas">
                            <StackPanel>
                                <Path Data="M 8,3 A 3,3 0 1 0 8,9 A 3,3 0 1 0 8,3 M 1,23 L 1,17 C 1,11 15,11 15,17 L 15,23 M 17,4 A 3,3 0 0 1 17,10 M 18,14 C 23,14 23,17 23,22" Style="{StaticResource IconeAcao}" />
                                <TextBlock Text="Alterar&#10;pessoas" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="cliente" Click="EditarDados_Click" Style="{StaticResource AcaoComanda}" AutomationProperties.Name="Adicionar ou alterar pessoa">
                            <StackPanel>
                                <Path Data="M 9,2 A 4,4 0 1 0 9,10 A 4,4 0 1 0 9,2 M 1,23 L 1,18 C 1,12 17,12 17,18 L 17,23 M 20,3 L 20,11 M 16,7 L 24,7" Style="{StaticResource IconeAcao}" />
                                <TextBlock Text="Adicionar&#10;pessoa" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Button Content="Concluir lançamento" Command="{Binding FecharEdicaoCommand}" Background="#23262B" Foreground="White" Height="86" FontWeight="Bold" Margin="0,0,8,0" Padding="8" ToolTip="Manter a comanda aberta e bloquear o atendimento" />
                        <Button Grid.Column="1" Content="Pagar" Command="{Binding VerTotalCommand}" Background="#408F63" Foreground="White" Height="86" FontWeight="Bold" Padding="8" ToolTip="Finalizar comanda (F4)" />
                    </Grid>

                </StackPanel>

                <TextBlock Grid.Row="4" Text="{Binding Mensagem}" Foreground="#B23B32" TextWrapping="Wrap" Margin="0,8,0,0" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
