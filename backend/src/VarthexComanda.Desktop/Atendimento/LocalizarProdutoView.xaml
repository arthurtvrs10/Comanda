<Window x:Class="VarthexComanda.Desktop.Atendimento.LocalizarProdutoView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:catalogo="clr-namespace:VarthexComanda.Desktop.Catalogo"
 Title="Localizar produto" Width="900" Height="740" MinWidth="740" MinHeight="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource AjudaCanvas}" Foreground="{DynamicResource AjudaInk}" FontFamily="Segoe UI" FontSize="12">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visivel"/><catalogo:FotoArquivoParaImagemConverter x:Key="FotoProduto"/>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,6"/><Setter Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/></Style>
  <Style x:Key="Modo" TargetType="RadioButton"><Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Quadro" Background="{DynamicResource AjudaSurface}" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Padding="10,7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Quadro" Property="Background" Value="{DynamicResource AjudaSoft}"/><Setter TargetName="Quadro" Property="BorderBrush" Value="{DynamicResource AjudaInk}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Quadro" Property="Background" Value="{DynamicResource AjudaHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Simbolo" TargetType="Path"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{DynamicResource AjudaInk}"/><Setter Property="StrokeThickness" Value="1.3"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
  <Style x:Key="CelulaLocalizador" TargetType="DataGridCell" BasedOn="{StaticResource CelulaTabela}"><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AjudaSoft}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="CabecalhoLocalizador" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource AjudaCanvas}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="Padding" Value="7,4"/><Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="LinhaLocalizador" TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="NomeLocalizador" TargetType="TextBlock" BasedOn="{StaticResource TextoTabela}"><Setter Property="ToolTip" Value="{Binding Nome}"/></Style>
  <Style x:Key="CartaoClicavel" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AjudaInk}"/><Setter Property="Background" Value="{DynamicResource AjudaSoft}"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid x:Name="CorpoLocalizador" Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,14,0"><TextBox x:Name="BuscaProduto" Text="{Binding Pedido.TextoBuscaCatalogo, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" FontSize="12" Padding="8,4" VerticalContentAlignment="Center" Background="{DynamicResource AjudaSurface}" Foreground="{DynamicResource AjudaInk}" BorderBrush="{DynamicResource AjudaLine}" AutomationProperties.Name="Pesquisar produto" ToolTip="Pesquisar pelo nome. Ctrl+F"/><TextBlock Text="Pesquisar produto…" Foreground="{DynamicResource AjudaMuted}" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Pedido.TextoBuscaCatalogo}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <RadioButton x:Name="ModoLista" Style="{StaticResource Modo}" GroupName="Visualizacao" IsChecked="{Binding Lista}" Margin="0,0,6,0" AutomationProperties.Name="Visualização em lista"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Simbolo}" Data="M1 1H17V17H1Z M4 5H14 M4 9H14 M4 13H14"/><TextBlock Text="Lista" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="ModoFotos" Style="{StaticResource Modo}" GroupName="Visualizacao" IsChecked="{Binding Fotos}" Margin="0,0,10,0" AutomationProperties.Name="Visualização com fotos"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Simbolo}" Data="M1 1H7V7H1Z M11 1H17V7H11Z M1 11H7V17H1Z M11 11H17V17H11Z"/><TextBlock Text="Fotos" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <Button Content="Atualizar" Command="{Binding AtualizarCommand}"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Padding="9"><DockPanel>
    <Button DockPanel.Dock="Top" Content="Todas" Command="{Binding TodasCommand}" Margin="0,0,0,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Categoria}" Value="{x:Null}"><Setter Property="Background" Value="{DynamicResource AjudaSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource AjudaInk}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <ListBox x:Name="CategoriasProdutos" ItemsSource="{Binding Pedido.Categorias}" SelectedItem="{Binding Categoria}" DisplayMemberPath="Nome" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AjudaInk}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Categorias de produtos">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="MinHeight" Value="42"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Fundo" Background="{DynamicResource AjudaSurface}" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource AjudaSoft}"/><Setter TargetName="Fundo" Property="BorderBrush" Value="{DynamicResource AjudaInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource AjudaHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel></Border>
   <Grid Grid.Column="2" Background="{DynamicResource AjudaSurface}">
    <DataGrid x:Name="TabelaLocalizador" ItemsSource="{Binding Produtos}" SelectedItem="{Binding Selecionado}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="42" ColumnHeaderHeight="42" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource AjudaLine}" CellStyle="{StaticResource CelulaLocalizador}" ColumnHeaderStyle="{StaticResource CabecalhoLocalizador}" RowStyle="{StaticResource LinhaLocalizador}" BorderBrush="{DynamicResource AjudaLine}" Background="{DynamicResource AjudaSurface}" Foreground="{DynamicResource AjudaInk}">
     <DataGrid.Style><Style TargetType="DataGrid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Fotos}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
     <DataGrid.Columns>
      <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" ElementStyle="{StaticResource TextoTabela}" Width="100"/><DataGridTextColumn Header="Cód." Binding="{Binding Codigo}" ElementStyle="{StaticResource NumeroTabela}" Width="55"/><DataGridTextColumn Header="Nome do produto" Binding="{Binding Nome}" ElementStyle="{StaticResource NomeLocalizador}" Width="*" MinWidth="130"/><DataGridTextColumn Header="Preço" Binding="{Binding Preco}" ElementStyle="{StaticResource NumeroTabela}" Width="85"/>
      <DataGridTemplateColumn Header="Adicionar" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Click="Adicionar_Click" Tag="{Binding}" MinWidth="32" Padding="6" AutomationProperties.Name="Adicionar produto"><Path Data="M8 1V15 M1 8H15" Style="{StaticResource Simbolo}" Margin="0"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Personalizar" Width="84"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Click="Personalizar_Click" Tag="{Binding}" MinWidth="32" Padding="6" AutomationProperties.Name="Personalizar produto"><Path Data="M1 8H3 M7 8H9 M13 8H15" Style="{StaticResource Simbolo}" Margin="0"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Visibility="{Binding Fotos, Converter={StaticResource Visivel}}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ListBox x:Name="FotosLocalizador" ItemsSource="{Binding Produtos}" SelectedItem="{Binding Selecionado}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Button x:Name="CartaoProduto" Style="{StaticResource CartaoClicavel}" Width="156" Height="190" Margin="4" Click="Personalizar_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Nome, StringFormat=Personalizar {0}}" ToolTip="Clique para personalizar e adicionar ao pedido">
      <Grid><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource AjudaSoft}" ClipToBounds="True"><Grid><Path Data="M8 1A7 7 0 1 0 8 15 A7 7 0 1 0 8 1 M8 4 A4 4 0 1 0 8 12 A4 4 0 1 0 8 4 M19 1V6 M22 1V6 M25 1V6 M19 5Q22 10 25 5 M22 8V16" Width="40" Height="32" Stretch="Uniform" Stroke="{DynamicResource AjudaMuted}" StrokeThickness="1.2"/><Image Source="{Binding Foto, Converter={StaticResource FotoProduto}}" Stretch="UniformToFill"/></Grid></Border>
      <StackPanel Grid.Row="1" Margin="8,4,8,0"><TextBlock Text="{Binding Codigo}" FontSize="11" Foreground="{DynamicResource AjudaMuted}"/><TextBlock Text="{Binding Nome}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" ToolTip="{Binding Nome}" FontWeight="SemiBold" Foreground="{DynamicResource AjudaInk}"/></StackPanel>
      <TextBlock Grid.Row="2" Text="{Binding Preco}" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource AjudaInk}"/>
     </Grid></Button></DataTemplate></ListBox.ItemTemplate>
    </ListBox></ScrollViewer></Border>
    <TextBlock Text="Nenhum produto encontrado. Altere a busca ou a categoria." TextWrapping="Wrap" Margin="20,70,20,0" VerticalAlignment="Top" Foreground="{DynamicResource AjudaMuted}" Visibility="{Binding SemProdutos, Converter={StaticResource Visivel}}" IsHitTestVisible="False"/>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True"><Button DockPanel.Dock="Right" Content="Voltar ao pedido" IsCancel="True" Margin="12,0,0,0"/><TextBlock DockPanel.Dock="Right" Text="{Binding TotalEncontrados}" Foreground="{DynamicResource AjudaMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
 </Grid>
</Window>
