<Window x:Class="VarthexComanda.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VarthexComanda.Desktop"
        mc:Ignorable="d"
        Title="Varthex Comanda" Icon="pack://application:,,,/VarthexComanda;component/Assets/VarthexComanda.ico" Height="780" Width="1280" MinHeight="600" MinWidth="800">
    <Window.Resources>
        <Style x:Key="AcaoSessao" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#263C32" />
            <Setter Property="BorderBrush" Value="#87988E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="AbaNavegacao" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#263C32" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EDF2EE" /></Trigger>
                        <Trigger Property="Tag" Value="ativa"><Setter TargetName="Surface" Property="Background" Value="#E1E8E4" /><Setter TargetName="Surface" Property="BorderBrush" Value="#245640" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#CCDCD1" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaAtendimentoCommand}" />
        <KeyBinding Key="NumPad1" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaAtendimentoCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaProdutosCommand}" />
        <KeyBinding Key="NumPad2" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaProdutosCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaHistoricoCommand}" />
        <KeyBinding Key="NumPad3" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaHistoricoCommand}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaBackupCommand}" />
        <KeyBinding Key="NumPad4" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaBackupCommand}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaConfiguracoesCommand}" />
        <KeyBinding Key="NumPad5" Modifiers="Control" Command="{x:Static local:MainWindow.IrParaConfiguracoesCommand}" />
    </Window.InputBindings>
    <Grid>
    <DockPanel x:Name="AreaSistema" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Border DockPanel.Dock="Bottom" Background="#F2F2F0" BorderBrush="#C4C4C4" BorderThickness="0,1,0,0" Padding="12,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Desenvolvido pela Varthex" Foreground="#666666" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Image Source="Assets/LogoRodape.png" Width="100" Height="24" Stretch="Uniform" AutomationProperties.Name="Varthex Comanda" />
            </StackPanel>
        </Border>
        <!-- Visivel apenas no modo de restauracao (banco corrompido): ver MainWindow.EntrarModoRestauracao. -->
        <Border x:Name="FaixaRestauracao" DockPanel.Dock="Top" Background="#B71C1C" Padding="16,12" Visibility="Collapsed">
            <TextBlock Text="O banco de dados está corrompido. Restaure um backup para continuar. Nenhuma outra função está disponível."
                       Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#C4D0C7" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <WrapPanel x:Name="AbasNavegacao" KeyboardNavigation.TabNavigation="Continue" VerticalAlignment="Top">
                    <Button x:Name="BotaoAtendimento" Click="MostrarAtendimento_Click" Style="{StaticResource AbaNavegacao}" AutomationProperties.Name="Atendimento" ToolTip="Ctrl+1" AutomationProperties.AccessKey="Ctrl+1">
                        <StackPanel Orientation="Horizontal"><Path Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,8,0" /><TextBlock Text="Atendimento" VerticalAlignment="Center" /><TextBlock Text="Ctrl+1" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BotaoProdutos" Click="MostrarProdutos_Click" Style="{StaticResource AbaNavegacao}" AutomationProperties.Name="Produtos" ToolTip="Ctrl+2" AutomationProperties.AccessKey="Ctrl+2">
                        <StackPanel Orientation="Horizontal"><Path Data="M3,7 L12,3 L21,7 V21 H3 Z M3,7 L12,11 L21,7 M12,11 V21" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,8,0" /><TextBlock Text="Produtos" VerticalAlignment="Center" /><TextBlock Text="Ctrl+2" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BotaoHistorico" Click="MostrarHistorico_Click" Style="{StaticResource AbaNavegacao}" AutomationProperties.Name="Histórico" ToolTip="Ctrl+3" AutomationProperties.AccessKey="Ctrl+3">
                        <StackPanel Orientation="Horizontal"><Path Data="M4,5 H20 V21 H4 Z M8,2 V8 M16,2 V8 M4,11 H20 M8,15 H16" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,8,0" /><TextBlock Text="Histórico" VerticalAlignment="Center" /><TextBlock Text="Ctrl+3" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BotaoBackup" Click="MostrarBackup_Click" Style="{StaticResource AbaNavegacao}" AutomationProperties.Name="Backup" ToolTip="Ctrl+4" AutomationProperties.AccessKey="Ctrl+4">
                        <StackPanel Orientation="Horizontal"><Path Data="M4,16 V4 H20 V16 M12,10 V22 M8,18 L12,22 L16,18" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,8,0" /><TextBlock Text="Backup" VerticalAlignment="Center" /><TextBlock Text="Ctrl+4" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BotaoConfiguracoes" Click="MostrarConfiguracao_Click" Style="{StaticResource AbaNavegacao}" AutomationProperties.Name="Configurações" ToolTip="Ctrl+5" AutomationProperties.AccessKey="Ctrl+5">
                        <StackPanel Orientation="Horizontal"><Path Data="M3,6 H21 M3,12 H21 M3,18 H21 M8,3 V9 M16,9 V15 M10,15 V21" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,8,0" /><TextBlock Text="Configurações" VerticalAlignment="Center" /><TextBlock Text="Ctrl+5" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BotaoLicenca" Click="MostrarLicenca_Click" Style="{StaticResource AbaNavegacao}" AutomationProperties.Name="Licença">
                        <StackPanel Orientation="Horizontal"><Path Data="M5,3 H19 V21 H5 Z M8,7 H16 M8,11 H16 M8,15 H13" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,8,0" /><TextBlock Text="Licença" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BotaoCozinha" Click="MostrarCozinha_Click" Style="{StaticResource AbaNavegacao}" AutomationProperties.Name="Comandas abertas">
                        <StackPanel Orientation="Horizontal"><Path Data="M5,3 H19 V21 H5 Z M8,7 H16 M8,11 H16 M8,15 H13" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,8,0" /><TextBlock Text="Comandas abertas" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock x:Name="RotuloPerfil" VerticalAlignment="Center" FontSize="13" Foreground="#52675A" Margin="8,0,12,0" />
                    <Button Content="Menu principal" Click="MenuPrincipal_Click" Style="{StaticResource AcaoSessao}" />
                    <Button x:Name="BotaoPerfil" Click="AlternarPerfil_Click" Style="{StaticResource AcaoSessao}" />
                    <Button Content="Bloquear" Click="Bloquear_Click" Style="{StaticResource AcaoSessao}" Background="#263C32" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>
        <ContentControl x:Name="ConteudoPrincipal" />
    </DockPanel>
    <ContentControl x:Name="MenuInicial" Panel.ZIndex="5" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    <ContentControl x:Name="CamadaBloqueio" Panel.ZIndex="10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
