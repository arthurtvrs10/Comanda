<Window x:Class="VarthexComanda.Desktop.Rede.JanelaServidor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Servidor / acesso pelo celular" Width="660" Height="600" MinWidth="520" MinHeight="460" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12" Background="{DynamicResource AjudaCanvas}" Foreground="{DynamicResource AjudaInk}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="Atendimento pelo celular" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <TextBlock Text="Conecte o celular à mesma rede Wi-Fi deste computador para abrir comandas e lançar produtos." TextWrapping="Wrap" Margin="0,0,0,18"/>
   <TextBlock x:Name="Estado" Text="Servidor parado" FontWeight="SemiBold" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/>
   <Label Content="Porta do servidor" Target="{Binding ElementName=Porta}" Padding="0,0,0,6"/>
   <TextBox x:Name="Porta" Text="3001" Width="110" MinHeight="34" Padding="7" HorizontalAlignment="Left" AutomationProperties.Name="Porta do servidor"/>
   <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,18,0"><Label Content="Endereço da rede" Target="{Binding ElementName=Enderecos}" Padding="0,0,0,6"/>
     <ComboBox x:Name="Enderecos" MinHeight="36" SelectionChanged="Endereco_Changed" AutomationProperties.Name="Endereço do servidor"/>
     <TextBlock Text="Leia o QR Code ou copie o link para o celular. O link autoriza abrir comandas e adicionar itens; pagamentos e fechamento ficam no computador." TextWrapping="Wrap" Margin="0,12,0,10"/>
     <Button x:Name="Copiar" Content="Copiar link de acesso" Click="Copiar_Click" MinHeight="36" HorizontalAlignment="Left" Padding="12,6" IsEnabled="False"/>
    </StackPanel>
    <Border Grid.Column="1" Background="White" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Width="180" Height="180" Padding="8" VerticalAlignment="Top"><Grid>
     <Image x:Name="Qr" Stretch="Uniform" AutomationProperties.Name="Código QR de acesso pelo celular"/>
     <TextBlock x:Name="QrVazio" Text="Inicie o servidor para mostrar o QR Code" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="#535D65" Margin="12"/>
    </Grid></Border>
   </Grid>
   <TextBlock Text="Use uma rede confiável. O computador deve permanecer ligado com o Comanda aberto. Cada início gera um novo link de acesso." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}" Margin="0,18,0,10"/>
   <TextBlock Text="Se o celular não conectar, confira o Wi-Fi e a permissão do Comanda no Firewall do Windows para redes privadas." TextWrapping="Wrap" Foreground="{DynamicResource AjudaMuted}"/>
   <TextBlock x:Name="Mensagem" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="False"><Button Content="Fechar" Click="Fechar_Click" MinHeight="36" Padding="18,6" DockPanel.Dock="Left"/><Button x:Name="Alternar" Content="Iniciar servidor" Click="Alternar_Click" MinHeight="36" Padding="18,6" DockPanel.Dock="Right"/></DockPanel>
 </Grid>
</Window>
