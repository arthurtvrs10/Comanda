<UserControl x:Class="VarthexComanda.Desktop.Backup.BackupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource AjudaCanvas}" Foreground="{DynamicResource AjudaInk}" FontFamily="Segoe UI" FontSize="12">
 <UserControl.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,7"/>
   <Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Setter Property="Background" Value="{DynamicResource AjudaSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource AjudaLine}"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Nota" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource AjudaMuted}"/><Setter Property="LineHeight" Value="17"/></Style>
  <Style x:Key="Titulo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,22"/></Style>
 </UserControl.Resources>
 <Grid><Grid x:Name="PaginaConfiguracao" Margin="18"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding ExibindoProgresso}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="RolagemBackup" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,0,8,0">
   <StackPanel x:Name="CorpoBackup" MinWidth="680" Width="{Binding ViewportWidth, ElementName=RolagemBackup}" IsEnabled="{Binding PodeInteragir}">
    <Grid Margin="0,0,0,22">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="1"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*" MinWidth="240"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <TextBlock Text="Configurar backup" Style="{StaticResource Titulo}"/>
      <TextBlock Text="Backups automáticos neste computador" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <TextBlock Text="Pasta onde os backups locais são guardados:" Style="{StaticResource Nota}" Margin="0,0,0,8"/>
      <Grid IsEnabled="{Binding PodeCriarBackup}" Margin="0,0,0,7">
       <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ContentControl x:Name="IconePasta" VerticalAlignment="Center"/>
       <TextBox Grid.Column="1" Text="{Binding PastaLocal, Mode=OneWay}" ToolTip="{Binding PastaLocal}" IsReadOnly="True" VerticalContentAlignment="Center" MinHeight="36" FontSize="12" Padding="7,4" Margin="0,0,8,0" Background="{DynamicResource AjudaSurface}" Foreground="{DynamicResource AjudaInk}" BorderBrush="{DynamicResource AjudaLine}" AutomationProperties.Name="Pasta de backup local"/>
       <Button Grid.Column="2" Content="Alterar pasta" Tag="local" Click="ConfigurarPasta_Click"/>
      </Grid>
      <TextBlock Text="{Binding ResumoPastas}" Style="{StaticResource Nota}" Margin="0,0,0,26"/>
      <TextBlock Text="Backups nas pastas da nuvem" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <TextBlock Text="Selecione uma pasta já sincronizada pelo Google Drive ou OneDrive neste computador." Style="{StaticResource Nota}" Margin="0,0,0,12"/>
      <Grid IsEnabled="{Binding PodeCriarBackup}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Padding="14">
        <StackPanel>
         <ContentControl x:Name="IconeDrive" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Google Drive" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="{Binding PastaGoogleDrive}" ToolTip="{Binding PastaGoogleDrive}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource Nota}" Margin="0,0,0,6"/>
         <TextBlock Text="{Binding StatusGoogleDrive}" Style="{StaticResource Nota}" MinHeight="34" Margin="0,0,0,12"/>
         <Button Content="Configurar" Tag="drive" Click="ConfigurarPasta_Click" AutomationProperties.Name="Configurar Google Drive"/>
         <Button Content="Desconectar pasta" Tag="drive" Click="DesconectarPasta_Click" Margin="0,6,0,0" MinHeight="28"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GoogleDriveConfigurado}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" BorderBrush="{DynamicResource AjudaLine}" BorderThickness="1" Padding="14">
        <StackPanel>
         <ContentControl x:Name="IconeOneDrive" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="OneDrive" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="{Binding PastaOneDrive}" ToolTip="{Binding PastaOneDrive}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource Nota}" Margin="0,0,0,6"/>
         <TextBlock Text="{Binding StatusOneDrive}" Style="{StaticResource Nota}" MinHeight="34" Margin="0,0,0,12"/>
         <Button Content="Configurar" Tag="onedrive" Click="ConfigurarPasta_Click" AutomationProperties.Name="Configurar OneDrive"/>
         <Button Content="Desconectar pasta" Tag="onedrive" Click="DesconectarPasta_Click" Margin="0,6,0,0" MinHeight="28"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding OneDriveConfigurado}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        </StackPanel>
       </Border>
      </Grid>
      <TextBlock Text="O Varthex grava em Varthex\Backups dentro da pasta escolhida. O envio à nuvem depende do aplicativo de sincronização; confira nele se o envio terminou." Style="{StaticResource Nota}" Margin="0,10,0,0"/>
     </StackPanel>
     <Border Grid.Column="2" Background="{DynamicResource AjudaLine}"/>
     <StackPanel Grid.Column="4">
      <TextBlock Text="Restaurar backup" Style="{StaticResource Titulo}"/>
      <TextBlock Text="Restaurar um backup existente" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <TextBlock Text="Escolha um arquivo salvo neste computador ou na pasta sincronizada da nuvem." Style="{StaticResource Nota}" Margin="0,0,0,20"/>
            <Grid Margin="0,0,0,20">
       <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ContentControl x:Name="IconeAlertaRestauracao" VerticalAlignment="Top" Margin="0,2,6,0"/>
       <StackPanel Grid.Column="1">
        <TextBlock Text="Os dados atuais serão substituídos. O sistema guarda uma cópia de segurança antes de restaurar e reinicia ao concluir." Style="{StaticResource Nota}" Margin="0,0,0,14"/>
        <TextBlock Text="Se cadastrou fotos para os produtos, restaure também o backup de fotos." Style="{StaticResource Nota}"/>
       </StackPanel>
      </Grid>
      <Button Click="SelecionarArquivo_Click" Margin="0,0,0,10" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><ContentControl x:Name="IconeDados" Margin="0,0,9,0"/><TextBlock Text="Restaurar dados" VerticalAlignment="Center"/></StackPanel></Button>
      <TextBlock Text="Selecione o arquivo .db. Para recuperar as fotos junto com os dados, mantenha o .fotos.zip na mesma pasta do backup." Style="{StaticResource Nota}" Margin="0,0,0,22"/>
      <Button Click="RestaurarFotos_Click" IsEnabled="{Binding PodeRestaurarFotos}" Margin="0,0,0,10" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><ContentControl x:Name="IconeFotos" Margin="0,0,9,0"/><TextBlock Text="Restaurar somente fotos" VerticalAlignment="Center"/></StackPanel></Button>
      <TextBlock Text="Selecione um .fotos.zip do Varthex. As fotos atuais são guardadas antes; os dados permanecem como estão." Style="{StaticResource Nota}"/>
     </StackPanel>
    </Grid>

   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="1" Margin="0,14,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding Mensagem}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Nota}"><Style.Triggers><DataTrigger Binding="{Binding MensagemErro}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextB71C1C}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <Button Grid.Column="2" Content="Fazer backup agora" Click="CriarBackup_Click" IsEnabled="{Binding PodeCriarBackup}" Background="{DynamicResource AjudaAction}" Foreground="{DynamicResource AjudaActionInk}">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding ModoRestauracao}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
   </Button>
   <Button Grid.Column="2" Content="Restaurar dados" Click="SelecionarArquivo_Click" IsEnabled="{Binding PodeInteragir}" Background="{DynamicResource AjudaAction}" Foreground="{DynamicResource AjudaActionInk}">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ModoRestauracao}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
   </Button>
  </Grid>
 </Grid>
 <Grid x:Name="PaginaProgresso" Margin="30,24,12,14">
  <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ExibindoProgresso}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
   <Grid Height="24" Margin="0,0,0,7">
    <StackPanel x:Name="PontosProgresso" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EstadoProgresso}" Value="andamento"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <Ellipse Width="6" Height="6" Fill="#6D2720" Margin="3,0"/><Ellipse Width="6" Height="6" Fill="#B94429" Margin="3,0"/><Ellipse Width="6" Height="6" Fill="#E98B42" Margin="3,0"/>
    </StackPanel>
    <Path Width="23" Height="23" Stretch="Uniform" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center">
     <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
      <DataTrigger Binding="{Binding EstadoProgresso}" Value="sucesso"><Setter Property="Visibility" Value="Visible"/><Setter Property="Stroke" Value="#41A85F"/><Setter Property="Data" Value="M2,10 L8,16 L22,2"/></DataTrigger>
      <DataTrigger Binding="{Binding EstadoProgresso}" Value="aviso"><Setter Property="Visibility" Value="Visible"/><Setter Property="Stroke" Value="{DynamicResource TextBF701F}"/><Setter Property="Data" Value="M12,1 L23,22 H1 Z M12,7 V14 M12,17 V18"/></DataTrigger>
      <DataTrigger Binding="{Binding EstadoProgresso}" Value="falha"><Setter Property="Visibility" Value="Visible"/><Setter Property="Stroke" Value="{DynamicResource TextB71C1C}"/><Setter Property="Data" Value="M3,3 L21,21 M21,3 L3,21"/></DataTrigger>
     </Style.Triggers></Style></Path.Style>
    </Path>
   </Grid>
   <TextBlock Text="{Binding TituloProgresso}" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <ScrollViewer x:Name="RolagemProgresso" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,18,0" AutomationProperties.Name="Progresso do backup">
   <ItemsControl ItemsSource="{Binding Progresso}"><ItemsControl.ItemTemplate><DataTemplate>
    <TextBlock Text="{Binding Texto}" Margin="0,0,0,14" TextWrapping="Wrap" LineHeight="18"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AjudaInk}"/><Style.Triggers><DataTrigger Binding="{Binding Aviso}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
  <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="94" IsEnabled="{Binding PodeInteragir}" Click="VoltarProgresso_Click" ToolTip="Voltar às opções de backup após a conclusão">
   <StackPanel Orientation="Horizontal"><Path Data="M10,1 L1,10 L10,19" Width="10" Height="18" Stretch="Uniform" Stroke="{DynamicResource AjudaMuted}" StrokeThickness="1.2" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Voltar" VerticalAlignment="Center"/></StackPanel>
  </Button>
 </Grid>
 </Grid></UserControl>
